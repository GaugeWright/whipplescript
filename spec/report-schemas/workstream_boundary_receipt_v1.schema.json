{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whipplescript.dev/schemas/workstream_boundary_receipt_v1.schema.json",
  "title": "WhippleScript Workstream Boundary Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_authority_id",
    "stream_id",
    "reservation_id",
    "outcome",
    "expected_stream_cut",
    "expected_main_cut",
    "proposed_main_cut",
    "recorded_at"
  ],
  "properties": {
    "schema": { "const": "workstream_boundary_receipt_v1" },
    "workspace_authority_id": { "$ref": "#/$defs/nonempty" },
    "stream_id": { "$ref": "#/$defs/nonempty" },
    "reservation_id": { "$ref": "#/$defs/nonempty" },
    "outcome": {
      "description": "boundary_reserved is the durable reservation projection; reserved is its retained v1 report spelling.",
      "enum": ["reserved", "boundary_reserved", "conflicted", "ref_advanced", "archived", "indeterminate"]
    },
    "expected_stream_cut": { "type": "string" },
    "expected_main_cut": { "type": "string" },
    "proposed_main_cut": { "$ref": "#/$defs/nonempty" },
    "main_ref_position": { "type": ["integer", "null"], "minimum": 0 },
    "ref_receipt_handle": {
      "type": ["string", "null"],
      "description": "Frozen v1 evidence identifier: SHA-256 truncated to 128 bits; not an authorization proof.",
      "pattern": "^sha256:[0-9a-f]{32}$"
    },
    "recorded_at": { "$ref": "#/$defs/nonempty" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["ref_advanced", "archived"] } } },
      "then": {
        "required": ["main_ref_position", "ref_receipt_handle"],
        "properties": {
          "main_ref_position": { "type": "integer", "minimum": 0 },
          "ref_receipt_handle": { "type": "string", "pattern": "^sha256:[0-9a-f]{32}$" }
        }
      }
    }
  ],
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 }
  }
}
