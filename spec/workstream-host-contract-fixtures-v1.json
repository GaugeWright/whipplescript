{
  "schema": "whipplescript.workstream_host_contract_fixtures.v1",
  "contract_revision": "whipplescript-workstream-host/v1.0.2",
  "cases": [
    {
      "id": "cancelled_boundary_cleanup_survives_each_crash",
      "given": { "stream_status": "active", "pending_cleanup_token": "cancelled" },
      "when": "restart_after_each_cleanup_write_then_promote",
      "expect": { "old_lock_released": true, "new_promotion_succeeds": true, "cancelled_cas_replayed": false },
      "coverage": "effect_handlers::promote_door_tests::promotion_recovers_cancelled_line_lock_after_restart"
    },
    {
      "id": "cleanup_failures_and_stale_tokens_preserve_the_owner",
      "given": { "cleanup_failures": ["topology", "line", "acknowledgement", "foreign-lock"] },
      "when": "cancel_then_retry_with_fresh_host_adapters",
      "expect": { "cleanup_coordinate_retained_until_ack": true, "new_reservation_waits": true, "foreign_lock_preserved": true, "main_unchanged": true },
      "coverage": "do_workstreams::tests::do_cancellation_cleanup_retains_its_token_until_both_stores_finish"
    },
    {
      "id": "reservation_freezes_topology_and_contribution",
      "given": {
        "status": "active",
        "expected_stream_cut": "cut-line-7",
        "expected_main_cut": "cut-main-11",
        "proposed_main_cut": "cut-main-12"
      },
      "when": "reserve_boundary",
      "expect": {
        "status": "boundary_reserved",
        "join": "stream_reserved",
        "leave": "refused",
        "transfer": "stream_reserved",
        "reconcile": "boundary_reserved"
      },
      "coverage": "workstreams::tests::reservation_freezes_both_sides_of_atomic_transfer"
    },
    {
      "id": "conflict_releases_without_main_movement",
      "given": {
        "status": "boundary_reserved",
        "expected_main_cut": "cut-main-11",
        "conflicting_path": "src/config.whip"
      },
      "when": "promote_line_exact",
      "expect": {
        "outcome": "conflicted",
        "status": "active",
        "main_cut": "cut-main-11",
        "ref_receipt_handle": null
      },
      "coverage": "vcs::tests::boundary_conflict_moves_no_pointer"
    },
    {
      "id": "post_cas_recovery_closes_forward",
      "given": {
        "status": "boundary_reserved",
        "main_cut": "cut-main-12",
        "proposed_main_cut": "cut-main-12"
      },
      "when": "recover_boundary_ref_evidence",
      "expect": {
        "status_sequence": ["ref_advanced", "archived"],
        "main_cas_count": 0,
        "ref_receipt_handle": "sha256:00000000000000000000000000000000"
      },
      "coverage": "vcs::tests::reserved_boundary_promotes_with_one_exact_main_cas"
    },
    {
      "id": "receipt_handles_match_shipped_v1_schema",
      "given": {
        "receipt_schemas": ["workstream_boundary_receipt_v1", "branch_home_receipt_v1", "exact_fork_admission_v1"]
      },
      "when": "create_receipt",
      "expect": {
        "handle_prefix": "sha256:",
        "digest_hex_digits": 32,
        "workspace_content_ids_unchanged": true
      },
      "coverage": "workstreams::tests::home_receipt_positions_distinguish_rejoin_history",
      "additional_coverage": [
        "workstreams::tests::exact_fork_admission_keeps_source_content_and_rejects_closed_home_first",
        "vcs::tests::exact_instance_fork_uses_historical_cut_not_source_tip",
        "vcs::tests::reserved_boundary_promotes_with_one_exact_main_cas"
      ]
    },
    {
      "id": "v1_receipt_identity_survives_runtime_upgrade",
      "given": {
        "source_revision": "44302912257d49dbf033fe2543400c640f6fa71b",
        "native_store_fixtures": ["fork", "archived", "landed"]
      },
      "when": "open_with_successor_and_retry",
      "expect": {
        "historical_receipts_unchanged": true,
        "exact_fork_evidence_unchanged": true,
        "post_cas_recovery_main_writes": 0,
        "workspace_content_ids_unchanged": true
      },
      "coverage": "mtarget_receipt_upgrade::old_home_and_lost_fork_response_replay_the_original_evidence",
      "additional_coverage": [
        "mtarget_receipt_upgrade::old_archived_receipt_replays_without_rewriting_its_handle",
        "mtarget_receipt_upgrade::old_landed_boundary_recovers_without_rekeying_the_accepted_fact",
        "mtarget_receipt_upgrade::old_post_cas_store_closes_forward_without_another_main_write"
      ]
    },
    {
      "id": "historical_promotion_receipt_survives_later_main_work",
      "given": {
        "accepted_promotion": "main-2",
        "later_main_cut": "main-3",
        "unreferenced_proposal": "orphan"
      },
      "when": "boundary_ref_evidence",
      "expect": {
        "original_receipt_unchanged": true,
        "orphan_is_not_acceptance": true,
        "explicit_undo_preserves_acceptance_evidence": true,
        "main_cas_count": 0
      },
      "coverage": "vcs::tests::boundary_evidence_is_stable_after_later_main_cuts_and_orphan_proposals",
      "coordinator_coverage": "effect_handlers::promote_door_tests::promotion_recovery_after_another_promotion_preserves_the_original_receipt"
    },
    {
      "id": "sparse_member_import_preserves_absent_partition",
      "given": {
        "manifest_paths": ["target-a/src.txt", "target-b/src.txt"],
        "materialized_paths": ["target-a/src.txt"]
      },
      "when": "import_scratch",
      "expect": {
        "changed_paths": ["target-a/src.txt"],
        "removed_paths": [],
        "untouched_paths": ["target-b/src.txt"]
      },
      "coverage": "materialize::tests::subset_materialization_respects_closure_and_budget"
    },
    {
      "id": "exact_fork_admits_home_without_rematerialization",
      "given": {
        "source_cut": "chat-1",
        "source_tip": "chat-2",
        "destination_head": "line-1",
        "destination_status": "active"
      },
      "when": "fork_at_cut_and_admit",
      "expect": {
        "outcome": "forked",
        "branch_point_cut": "chat-1",
        "content_source": "chat-1",
        "home_stream_id": "live"
      },
      "coverage": "workstreams::tests::exact_fork_admission_keeps_source_content_and_rejects_closed_home_first"
    },
    {
      "id": "archived_inherited_home_creates_nothing",
      "given": {
        "source_cut": "chat-1",
        "destination_stream_id": "closed",
        "destination_status": "archived"
      },
      "when": "fork_at_cut_and_admit",
      "expect": {
        "outcome": "historical_home_closed",
        "branch_created": false,
        "membership_created": false,
        "main_substituted": false
      },
      "coverage": "workstreams::tests::exact_fork_admission_keeps_source_content_and_rejects_closed_home_first"
    },
    {
      "id": "home_rejoin_has_new_authority_position",
      "given": {
        "home_sequence": ["one", "two", "one"]
      },
      "when": "transfer",
      "expect": {
        "authority_positions": [1, 2, 3],
        "first_and_last_evidence_differ": true
      },
      "coverage": "workstreams::tests::home_receipt_positions_distinguish_rejoin_history"
    },
    {
      "id": "concurrent_reservation_has_one_winner",
      "given": {
        "status": "active",
        "reservation_ids": ["race-a", "race-b"]
      },
      "when": "reserve_boundary_concurrently",
      "expect": {
        "reserved_count": 1,
        "busy_count": 1
      },
      "coverage": "workstreams::tests::concurrent_boundary_reservations_have_one_winner"
    },
    {
      "id": "concurrent_main_cas_has_one_winner",
      "given": {
        "expected_main_cut": "main-1",
        "proposed_main_cuts": ["main-race-a", "main-race-b"]
      },
      "when": "promote_line_exact_concurrently",
      "expect": {
        "promoted_count": 1,
        "expected_cuts_moved_count": 1,
        "main_advance_count": 1
      },
      "coverage": "vcs::tests::concurrent_exact_promotions_have_one_main_cas_winner"
    },
    {
      "id": "reserved_line_rejects_direct_head_advance",
      "given": {
        "line": "line-ws",
        "reservation_id": "reservation-ws",
        "head_cut": "line-1"
      },
      "when": "direct_branch_write",
      "expect": {
        "outcome": "reserved",
        "head_cut": "line-1",
        "body_changed": false
      },
      "coverage": "vcs::tests::reserved_stream_line_refuses_every_direct_head_advance"
    },
    {
      "id": "proposal_record_failure_precedes_main_publication",
      "given": {
        "expected_main_cut": "main-1",
        "proposed_main_cut": "main-2",
        "proposed_cut_identity": "occupied_by_incompatible_cut"
      },
      "when": "promote_line_exact",
      "expect": {
        "outcome": "immutable_cut_conflict",
        "main_cut": "main-1"
      },
      "coverage": "vcs::tests::promotion_cut_record_failure_cannot_publish_main"
    },
    {
      "id": "fork_identity_refusal_preserves_existing_home",
      "given": {
        "fork_branch_id": "occupied-fork-id",
        "existing_home": "other",
        "requested_home": "live"
      },
      "when": "fork_at_cut_and_admit",
      "expect": {
        "outcome": "fork_branch_id_taken",
        "final_home": "other",
        "authority_position_changed": false
      },
      "coverage": "workstreams::tests::exact_fork_admission_keeps_source_content_and_rejects_closed_home_first"
    },
    {
      "id": "exact_fork_lost_response_retry_replays_success",
      "given": {
        "source_cut": "chat-1",
        "target_instance": "child",
        "fork_branch_id": "chat-child",
        "existing_binding": "chat-child",
        "existing_home": "live"
      },
      "when": "fork_at_cut_and_admit",
      "expect": {
        "outcome": "forked",
        "branch_point_cut": "chat-1",
        "home_stream_id": "live",
        "authority_position_changed": false,
        "evidence_changed": false
      },
      "coverage": "workstreams::tests::exact_fork_admission_keeps_source_content_and_rejects_closed_home_first"
    },
    {
      "id": "native_pre_cas_error_releases_both_reservations",
      "given": {
        "status": "boundary_reserved",
        "expected_main_cut": "main-1",
        "proposed_main_cut": "occupied-cut",
        "proposed_cut_identity": "occupied_by_incompatible_cut"
      },
      "when": "promote_line_exact",
      "expect": {
        "outcome": "pre_cas_error",
        "main_cut": "main-1",
        "status": "active",
        "line_reservation_released": true
      },
      "coverage": "tests::cli_surface::native_promotion_releases_both_reservations_after_proven_pre_cas_error"
    },
    {
      "id": "hosted_pre_cas_error_releases_both_reservations",
      "given": {
        "status": "boundary_reserved",
        "expected_main_cut": "main-1",
        "proposed_main_cut": "occupied-cut",
        "proposed_cut_identity": "occupied_by_incompatible_cut"
      },
      "when": "promote_line_exact",
      "expect": {
        "outcome": "pre_cas_error",
        "main_cut": "main-1",
        "status": "active",
        "line_reservation_released": true
      },
      "coverage": "do_workstreams::tests::do_promote_releases_both_reservations_after_proven_pre_cas_error"
    },
    {
      "id": "native_post_cas_error_recovers_or_retains",
      "given": {
        "main_advanced": true,
        "operation_log_write": "fails_after_cas"
      },
      "when": "recover_boundary_ref_evidence",
      "expect": {
        "with_cut_evidence": "close_forward",
        "without_cut_evidence": "retain_both_reservations",
        "main_cas_count": 1
      },
      "coverage": "tests::cli_surface::native_promotion_releases_both_reservations_after_proven_pre_cas_error"
    },
    {
      "id": "hosted_post_cas_error_recovers_or_retains",
      "given": {
        "main_advanced": true,
        "operation_log_write": "fails_after_cas"
      },
      "when": "recover_boundary_ref_evidence",
      "expect": {
        "with_cut_evidence": "close_forward",
        "without_cut_evidence": "retain_both_reservations",
        "main_cas_count": 1
      },
      "coverage": "do_workstreams::tests::do_promote_releases_both_reservations_after_proven_pre_cas_error"
    },
    {
      "id": "discard_requires_unused_fork_evidence",
      "given": {
        "same_policy_instances": ["root", "unused_fork", "used_fork"]
      },
      "when": "host_discard_instance",
      "expect": {
        "root": "refused",
        "unused_fork": "discarded",
        "used_fork": "refused"
      },
      "coverage": "host_discard::tests::discard_eligibility_requires_fork_evidence_and_no_admitted_turn"
    },
    {
      "id": "discard_replay_key_is_namespaced_and_verified",
      "given": {
        "request_id": "reused-input",
        "colliding_event_type": "host.instance.opened"
      },
      "when": "host_discard_instance_replay",
      "expect": {
        "unrelated_event_accepted": false,
        "required_event_type": "instance.transitioned",
        "required_status": "cancelled"
      },
      "coverage": "host_discard::tests::discard_replay_accepts_only_the_exact_cancellation_event"
    }
  ]
}
