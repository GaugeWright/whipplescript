{
  "schema": "whipplescript.package_manifest.v0",
  "package_id": "std.custody",
  "name": "std.custody",
  "version": "0.1.0",
  "libraries": [
    {
      "id": "std.custody",
      "version": "0.1.0",
      "standard": true,
      "effect_contracts": [
        {
          "id": "custody.request",
          "effect_kind": "custody.request",
          "source_forms": [
            "request"
          ],
          "input_schema": "custody.request.input",
          "output_schema": "custody.request.output",
          "required_capabilities": [
            "custody.request"
          ],
          "provider_kinds": [
            "custodian"
          ],
          "projected_facts": [
            "effect.output"
          ],
          "validation": "runtime_boundary"
        },
        {
          "id": "custody.mint",
          "effect_kind": "custody.mint",
          "source_forms": [
            "mint credential from <parent> { \u2026 }"
          ],
          "input_schema": "custody.mint.input",
          "output_schema": "custody.mint.output",
          "required_capabilities": [
            "custody.mint"
          ],
          "provider_kinds": [
            "custodian"
          ],
          "projected_facts": [
            "effect.output"
          ],
          "validation": "runtime_boundary"
        },
        {
          "id": "custody.wrap",
          "effect_kind": "capability.call",
          "source_forms": [
            "call custody.wrap",
            "seal <value> with <credential> -> <binding>"
          ],
          "input_schema": {
            "credential": "string",
            "value": "json"
          },
          "output_schema": {
            "credential": "string",
            "context": "string",
            "label": "json",
            "nonce_b64": "string",
            "ciphertext_b64": "string"
          },
          "required_capabilities": [
            "custody.wrap"
          ],
          "provider_kinds": [
            "custody-provider"
          ],
          "validation": "runtime_boundary"
        },
        {
          "id": "custody.unwrap",
          "effect_kind": "capability.call",
          "source_forms": [
            "call custody.unwrap",
            "open <sealed> into <Type> with <credential> as <binding>"
          ],
          "input_schema": {
            "credential": "string",
            "envelope": "json",
            "payload_type": "string"
          },
          "output_schema": {
            "credential": "string",
            "context": "string",
            "payload_type": "string"
          },
          "required_capabilities": [
            "custody.unwrap"
          ],
          "provider_kinds": [
            "custody-provider"
          ],
          "validation": "runtime_boundary"
        }
      ],
      "constructs": [
        {
          "id": "custody.seal",
          "construct_family": "effect_operation",
          "keyword": "seal",
          "scope": "rule_body",
          "grammar": {
            "shape": "effect_operation",
            "keyword": "seal",
            "slots": [
              {
                "name": "value",
                "kind": "expression"
              },
              {
                "name": "credential",
                "kind": "identifier",
                "connective": "with"
              }
            ],
            "payload": null,
            "binding": "required",
            "target_capability": "custody.wrap"
          },
          "requires": [
            {
              "kind": "Capability",
              "name": "custody.wrap"
            }
          ],
          "provides": [
            {
              "kind": "EffectHandle",
              "type": "custody.wrap.output"
            }
          ],
          "lowering_target": "capability_call",
          "target_capability": "custody.wrap"
        },
        {
          "id": "custody.open",
          "construct_family": "effect_operation",
          "keyword": "open",
          "scope": "rule_body",
          "grammar": {
            "shape": "effect_operation",
            "keyword": "open",
            "slots": [
              {
                "name": "envelope",
                "kind": "expression"
              },
              {
                "name": "payload_type",
                "kind": "identifier",
                "connective": "into"
              },
              {
                "name": "credential",
                "kind": "identifier",
                "connective": "with"
              }
            ],
            "payload": null,
            "binding": "required",
            "target_capability": "custody.unwrap"
          },
          "requires": [
            {
              "kind": "Capability",
              "name": "custody.unwrap"
            }
          ],
          "provides": [
            {
              "kind": "EffectHandle",
              "type": "custody.unwrap.output"
            }
          ],
          "lowering_target": "capability_call",
          "target_capability": "custody.unwrap"
        }
      ]
    }
  ],
  "capabilities": [
    {
      "id": "custody.request",
      "description": "Egress an authenticated HTTP request through the custodian (DR-0053 \u00a75). The request leaves whip carrying SENTINELS at the author's marked slots; the custodian substitutes material and signs, so the material never enters this process and no capability grants a way to read it."
    },
    {
      "id": "custody.mint",
      "description": "Exchange a credential for a scoped child, custodian-executed so the minted token never enters this process (DR-0053 \u00a75). The child is registered beneath its parent and inherits the parent's egress ceiling, which is what bounds a mint \u2014 whip does not model the vendor scope the exchange requests."
    },
    {
      "id": "custody.wrap",
      "description": "Seal a value into a custodian-held envelope. The wrapping key never reaches whip; the envelope carries the label and its AEAD context binding.",
      "schema": {
        "input": {
          "credential": "string"
        }
      }
    },
    {
      "id": "custody.unwrap",
      "description": "Open a custodian-held envelope back to its payload (DR-0074 \u00a73). The plaintext lives in the opening effect's `after` block and is never written to a durable record; the grant is narrowed by the payload's declared type.",
      "schema": {
        "input": {
          "credential": "string"
        }
      }
    }
  ],
  "providers": [
    {
      "id": "custodian",
      "provider_kind": "custodian",
      "capability": "custody.request",
      "config": {}
    },
    {
      "id": "custodian-mint",
      "provider_kind": "custodian",
      "capability": "custody.mint",
      "config": {}
    },
    {
      "id": "provider-custody-wrap",
      "provider_kind": "custody-provider",
      "capability": "custody.wrap",
      "config": {}
    },
    {
      "id": "provider-custody-unwrap",
      "provider_kind": "custody-provider",
      "capability": "custody.unwrap",
      "config": {}
    }
  ],
  "profiles": [
    {
      "id": "profile-custody-sealer",
      "name": "custody-sealer",
      "description": "Allow sealing values into custodian-held envelopes. Deliberately does not include unwrap: sealing is the safe direction, and opening is governed by a type-narrowed grant (DR-0074).",
      "enforcement_mode": "enforce",
      "allowed_capabilities": [
        "custody.wrap"
      ]
    }
  ],
  "bindings": [
    {
      "id": "binding-custody-request-default",
      "program_id": null,
      "capability": "custody.request",
      "provider": "custodian",
      "config": {
        "provider_id": "custodian"
      }
    },
    {
      "id": "binding-custody-mint-default",
      "program_id": null,
      "capability": "custody.mint",
      "provider": "custodian",
      "config": {
        "provider_id": "custodian-mint"
      }
    },
    {
      "id": "binding-custody-wrap-global",
      "program_id": null,
      "capability": "custody.wrap",
      "provider": "custody-provider",
      "config": {}
    },
    {
      "id": "binding-custody-unwrap-global",
      "program_id": null,
      "capability": "custody.unwrap",
      "provider": "custody-provider",
      "config": {}
    }
  ]
}
