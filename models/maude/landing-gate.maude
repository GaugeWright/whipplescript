  including LANDING-GATE .
  vars H C E U I S F X : Mark . var A : Artifact . var D : Door .
  var R : Ref . var CFG : Cfg .
  crl [ignore-expiry] :
    { certificate(D,R,A,H,C,E,U,I,S,F) commit(D,R,A) current(H,C,E,U,I,S,F,false) CFG }
    => { admitted(D,R,A) current(new,C,E,U,I,S,F,false) CFG } if gated(R) .
endm
mod LANDING-GATE-WEAK-CANDIDATE is
  including LANDING-GATE .
  vars H C E U I S F X : Mark . var A : Artifact . var D : Door .
  var R : Ref . var CFG : Cfg . var OTHER : Artifact .
  crl [substitute-candidate] :
    { certificate(D,R,A,H,C,E,U,I,S,F) commit(D,R,OTHER) current(H,C,E,U,I,S,F,true) CFG }
    => { admitted(D,R,OTHER) current(new,C,E,U,I,S,F,true) CFG } if gated(R) .
endm
