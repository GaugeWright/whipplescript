  including LANDING-GATE .
  vars H C E U I S F X : Mark . var A : Artifact . var D : Door .
  var R : Ref . var CFG : Cfg .
  crl [ignore-support] :
    { request(D,R,A,false,true) current(H,C,E,U,I,S,F,true) CFG }
    => { certificate(D,R,A,H,C,E,U,I,S,F) current(H,C,E,U,I,S,F,true) CFG } if gated(R) .
endm
mod LANDING-GATE-WEAK-SELF-GRANT is
  including LANDING-GATE .
  vars H C E U I S F X : Mark . var A : Artifact . var D : Door .
  var R : Ref . var CFG : Cfg .
  crl [candidate-self-authorizes] :
    { request(D,R,A,true,false) current(H,C,E,U,I,S,F,true) CFG }
    => { certificate(D,R,A,H,C,E,U,I,S,F) current(H,C,E,U,I,S,F,true) CFG } if gated(R) .
endm
mod LANDING-GATE-WEAK-BYPASS is
  including LANDING-GATE .
  vars H C E U I S F X : Mark . var A : Artifact . var D : Door .
  var R : Ref . var CFG : Cfg .
  rl [direct-store-bypasses-gate] : { commit(directStore,main,A) CFG }
    => { admitted(directStore,main,A) CFG } .
endm
mod LANDING-GATE-WEAK-BIND is
  including LANDING-GATE .
  vars H C E U I S F X : Mark . var A : Artifact . var D : Door .
  var R : Ref . var CFG : Cfg .
  rl [bind-mainline] : { bind(main) CFG } => { bound(main) CFG } .
endm
