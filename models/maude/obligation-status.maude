  vars R M A R1 M1 A1 : Ref . var P : Provenance . var F : Family .
  vars X Y : Observation . var C : Completion . var E : Exit .
  crl [omit-exit] : evaluate(report(R,M,A,R1,M1,A1,P,F,X,Y,C,E)) => judged(true, counter(report(R,M,A,R1,M1,A1,P,F,X,Y,C,E)), true)
    if R == R1 and M == M1 and A == A1 and P =/= unbound and F =/= empty and covered(report(R,M,A,R1,M1,A1,P,F,X,Y,C,E)) and C == complete and not hasFailure(report(R,M,A,R1,M1,A1,P,F,X,Y,C,E)) .
