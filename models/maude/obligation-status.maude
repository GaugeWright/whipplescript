mod OBLIGATION-STATUS-WEAK-COUNTER is
  including OBLIGATION-STATUS . var Q : Report .
  crl [erase-on-harness-failure] : evaluate(Q) => judged(false,false,true) if not adequate(Q) .
endm
mod OBLIGATION-STATUS-WEAK-VACUITY is
  including OBLIGATION-STATUS . vars W W1 : Worlds .
  rl [empty-premises-prove-anything] : prove(W,W1) => proof(allSatisfy(intersect(W,W1))) .
endm
mod OBLIGATION-STATUS-WEAK-UNIVERSAL is
  including OBLIGATION-STATUS . vars W W1 : Worlds .
  rl [nonempty-is-not-proof] : prove(W,W1) => proof(intersect(W,W1) =/= noWorld) .
endm
