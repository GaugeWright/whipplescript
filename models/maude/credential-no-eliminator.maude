--- DR-0053: credential custody, modelled at the language/compiler seam.
---
--- Two properties, one model, because they share a mechanism:
---
---   1. NO ELIMINATOR. A `secret`-typed value has exactly one lowering --
---      `present`, which yields a SENTINEL, not bytes. No rule sequence
---      available to whip's principal derives plaintext material from a
---      handle. This is what makes non-extractability a property of the
---      absence of an operation rather than of a scrubber guessing key
---      shapes.
---
---   2. SENTINEL INTEGRITY. A request declared to authenticate with handle H
---      cannot leave whip with its auth slot holding anything but
---      sentinel(H). DR-0042 checks this dynamically at the Worker by
---      rejecting non-sentinel auth headers; at the language level it is
---      static, and this is where that is proved. Staticness is why the
---      author's STATEMENT is in the model: whether the slot ends up marked
---      is decided by source text, not by a race.
---
--- The keyed chain matters as much as the material. In AWS SigV4 the derived
--- key kSigning is ITSELF a credential -- valid for that date/region/service
--- for seven days -- so `derived(H)` is a violation at whip exactly as
--- `material(H)` is. DR-0053 section 7 splits canonicalization from the keyed
--- chain on precisely this line: whip builds the string-to-sign (secret-free),
--- the custodian owns every keyed step.
---
--- Grounding in the DR:
---   at(whip, handle(H))     a `secret`-typed binding in a whip program
---   at(whip, sentinel(H))   the lowered marker, safe to serialize
---   at(P, material(H))      plaintext bytes; a violation iff P is whip
---   at(P, derived(H))       kSigning; a violation iff P is whip
---   needsCred(R, H)         the request is declared to authenticate with H
---   stmtPresent(R, H)       source wrote `header "Authorization" bearer h`
---   stmtLiteral(R)          source hand-rolled the header from a string
---   sealed(H)               the custodian holds H at some rung
---   leak / unmarked(R)      the two violations
mod WHIPPLESCRIPT-CREDENTIAL-NO-ELIMINATOR is
  sorts Prin Hnd Req Val Cfg .

  ops whip custodian : -> Prin [ctor] .
  ops h1 h2 : -> Hnd [ctor] .
  ops r1 : -> Req [ctor] .

  --- Values whip can hold. `plain` is any ordinary readable string: a header
  --- an author hand-wrote, a canonicalized string-to-sign, a response body.
  op plain : -> Val [ctor] .
  op handle : Hnd -> Val [ctor] .
  op sentinel : Hnd -> Val [ctor] .
  op material : Hnd -> Val [ctor] .
  op derived : Hnd -> Val [ctor] .
  op signature : -> Val [ctor] .
  --- A minted short-lived credential's bytes. Distinct from material(H)
  --- because it is a DIFFERENT credential, obtained by exchange rather than
  --- by unsealing -- but just as extractable, so just as forbidden at whip.
  op token : Hnd -> Val [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op at : Prin Val -> Cfg [ctor] .
  op sealed : Hnd -> Cfg [ctor] .
  --- `mint credential H2 from H`. whip declares the exchange and the
  --- extraction path; it never performs the exchange itself.
  op mintReq : Hnd Hnd -> Cfg [ctor] .
  op needsCred : Req Hnd -> Cfg [ctor] .
  op authSlot : Req Val -> Cfg [ctor] .
  op emitted : Req -> Cfg [ctor] .
  op leak : -> Cfg [ctor] .
  op unmarked : Req -> Cfg [ctor] .

  op stmtPresent : Req Hnd -> Cfg [ctor] .
  op stmtLiteral : Req -> Cfg [ctor] .

  vars H HN : Hnd .  vars R : Req .  vars P : Prin .  vars V : Val .

  --- Idempotence keeps the reachable state space finite; holding a value
  --- twice is holding it once.
  --- Idempotence keeps the reachable state space finite. authSlot needs it
  --- because the author's statement PERSISTS across the fill (it is program
  --- text, not a consumed token), so fill-sentinel/fill-plain stay enabled;
  --- without this equation each re-firing appends another copy and the search
  --- never terminates.
  eq at(P, V) at(P, V) = at(P, V) .
  eq authSlot(R, V) authSlot(R, V) = authSlot(R, V) .
  eq emitted(R) emitted(R) = emitted(R) .
  eq leak leak = leak .
  eq unmarked(R) unmarked(R) = unmarked(R) .
  --- [mint] PRODUCES a sealed handle for the credential it exchanges into, and
  --- mintReq persists, so this one is required for termination just as
  --- authSlot's is.
  eq sealed(H) sealed(H) = sealed(H) .

  --- WHIP'S COMPLETE OPERATION SET ON A SECRET-TYPED VALUE.
  --- `present` is the whole of it: bearer / basic / raw all lower a handle to
  --- a sentinel. There is deliberately no rule here taking handle(H) to
  --- material(H); that absence IS the theorem.
  rl [present] : at(whip, handle(H))
    => at(whip, handle(H)) at(whip, sentinel(H)) .

  --- The presentation form puts the sentinel in the declared auth slot.
  rl [fill-sentinel] : stmtPresent(R, H) at(whip, sentinel(H))
    => stmtPresent(R, H) at(whip, sentinel(H)) authSlot(R, sentinel(H)) .

  --- A hand-rolled header puts an ordinary string there instead. Well-formed
  --- in itself; a violation only when the request was DECLARED to
  --- authenticate with a credential (see detect-unmarked).
  rl [fill-plain] : stmtLiteral(R) at(whip, plain)
    => stmtLiteral(R) at(whip, plain) authSlot(R, plain) .

  --- whip hands the constructed request to the custodian.
  rl [emit] : authSlot(R, V) => authSlot(R, V) emitted(R) .

  --- The custodian substitutes at the marked slot. Material comes into
  --- existence HERE, in the custodian's principal, and never crosses back.
  rl [substitute] : emitted(R) authSlot(R, sentinel(H)) sealed(H)
    => emitted(R) authSlot(R, sentinel(H)) sealed(H) at(custodian, material(H)) .

  --- The keyed derivation chain (SigV4 kDate/kRegion/kService/kSigning) runs
  --- entirely custodian-side.
  rl [derive] : at(custodian, material(H))
    => at(custodian, material(H)) at(custodian, derived(H)) .

  --- The custodian returns a signature. A signature is not secret material,
  --- so it legitimately crosses back into whip.
  rl [sign-return] : at(custodian, derived(H))
    => at(custodian, derived(H)) at(whip, signature) .

  --- Credential EXCHANGE. If whip made the refresh call itself, the response
  --- body would carry the new token through whip's address space -- an
  --- extraction path that no amount of type discipline closes, because at that
  --- point the token really is an ordinary string. So the custodian performs
  --- the exchange, applies whip's declared extraction path, keeps the token,
  --- and hands back only a handle.
  rl [mint] : mintReq(H, HN) at(custodian, material(H))
    => mintReq(H, HN) at(custodian, material(H))
       at(custodian, token(HN)) at(whip, handle(HN)) sealed(HN) .

  --- VIOLATION 1: plaintext material, the derived signing key, or a minted
  --- token in whip's principal. All three are extractable credentials.
  rl [detect-material-leak] : at(whip, material(H))
    => at(whip, material(H)) leak .
  rl [detect-derived-leak] : at(whip, derived(H))
    => at(whip, derived(H)) leak .
  rl [detect-token-leak] : at(whip, token(H))
    => at(whip, token(H)) leak .

  --- VIOLATION 2: a request declared to authenticate with H left whip without
  --- the marked slot, so the custodian has nothing to substitute.
  rl [detect-unmarked] : emitted(R) needsCred(R, H) authSlot(R, plain)
    => emitted(R) needsCred(R, H) authSlot(R, plain) unmarked(R) .
endm

--- NEGATIVE FIXTURE. The same system plus the one operation DR-0053 rejects:
--- `get(handle)`. It is the whole hole -- one caller with a legitimate reason
--- re-establishes extractability for every credential -- and this module
--- exists to prove the main module's No-solution results have content rather
--- than a vacuous left-hand side.
mod WHIPPLESCRIPT-CREDENTIAL-NO-ELIMINATOR-REVEAL is
  sorts Prin Hnd Val Cfg .

  ops whip custodian : -> Prin [ctor] .
  ops h1 h2 : -> Hnd [ctor] .

  op plain : -> Val [ctor] .
  op handle : Hnd -> Val [ctor] .
  op sentinel : Hnd -> Val [ctor] .
  op material : Hnd -> Val [ctor] .
  op token : Hnd -> Val [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op at : Prin Val -> Cfg [ctor] .
  op sealed : Hnd -> Cfg [ctor] .
  op mintReq : Hnd Hnd -> Cfg [ctor] .
  op leak : -> Cfg [ctor] .

  vars H HN : Hnd .  vars P : Prin .  vars V : Val .

  eq at(P, V) at(P, V) = at(P, V) .
  eq leak leak = leak .

  rl [present] : at(whip, handle(H))
    => at(whip, handle(H)) at(whip, sentinel(H)) .

  --- REJECTED OPERATION 1: resolve a handle to its bytes.
  rl [reveal] : at(whip, handle(H)) sealed(H)
    => at(whip, handle(H)) sealed(H) at(whip, material(H)) .

  --- REJECTED OPERATION 2: whip performs the credential exchange itself and
  --- parses the response. No handle is ever revealed, yet the MINTED token
  --- lands in whip's address space -- a second, independent extraction path,
  --- and the reason `mint` must be custodian-executed.
  rl [mint-in-whip] : mintReq(H, HN) at(whip, handle(H))
    => mintReq(H, HN) at(whip, handle(H)) at(whip, token(HN)) .

  rl [detect-material-leak] : at(whip, material(H))
    => at(whip, material(H)) leak .
  rl [detect-token-leak] : at(whip, token(H))
    => at(whip, token(H)) leak .
endm
