mod TARGETED-RETIREMENT-WEAK-LIFECYCLE is
  including TARGETED-RETIREMENT .
  vars V A E H U V1 E1 H1 U1 : Id . vars S T R : Status . vars K K2 : Actor . var C : Cfg .
  crl [reuse-activation-permission] :
    { current(V,H,S) active(A,E,T) epoch(U) request(V1,E1,H1,U1,K,R) permits(accepted,R,K) retiring(R) C }
    => { current(V,retirementHead,if V == A then R else S fi) inactive history(A,E,T) epoch(U) permits(accepted,R,K) retiring(R) C }
    if V1 == A /\ E1 == E /\ H1 == H /\ U1 == U .
endm
