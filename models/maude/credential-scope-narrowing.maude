--- DR-0053 section 14: credential grants narrow per-operation, in two
--- classes. Not every custody operation admits glob narrowing, and a grant
--- form that accepted globs uniformly would OVER-PROMISE -- a clause that
--- reads as narrowed while meaning nothing for several operations. The two
--- classes are kept separate:
---
---   NARROWABLE:     request (host/method/path globs), mint (vendor scopes).
---                   These REQUIRE their list.
---   NON-NARROWABLE: sign, verify, derive, wrap, unwrap. Named bare; a glob
---                   list on one of them is a CHECK ERROR, not silently
---                   ignored -- silent acceptance is precisely the
---                   over-promise being avoided.
---
--- Glob matching itself is abstracted to membership (`listed`): the Rust
--- differential tests own real glob semantics; what this model owns is the
--- CLASS discipline -- which grant shapes are well-formed, and that admission
--- consults the list exactly when the class says it must.
---
--- Grounding:
---   grantList(H, O)     a grant clause carrying a glob list for O on H
---   listed(H, O, T)     target T is inside that clause's list
---   grantBare(H, O)     a grant clause naming O bare
---   attempt(H, O, T)    the turn tries operation O on H against target T
---   admitted(H, O, T)   the attempt passed the grant check
---   checkError          a malformed grant shape was rejected at check time
mod WHIPPLESCRIPT-CREDENTIAL-SCOPE-NARROWING is
  sorts Op Hnd Tgt Cfg .

  ops reqOp mintOp signOp verifyOp wrapOp : -> Op [ctor] .
  ops h1 : -> Hnd [ctor] .
  ops tIn tOut : -> Tgt [ctor] .

  op narrowable : Op -> Bool .
  eq narrowable(reqOp) = true .
  eq narrowable(mintOp) = true .
  eq narrowable(signOp) = false .
  eq narrowable(verifyOp) = false .
  eq narrowable(wrapOp) = false .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op grantList : Hnd Op -> Cfg [ctor] .
  op listed : Hnd Op Tgt -> Cfg [ctor] .
  op grantBare : Hnd Op -> Cfg [ctor] .
  op attempt : Hnd Op Tgt -> Cfg [ctor] .
  op admitted : Hnd Op Tgt -> Cfg [ctor] .
  op checkError : -> Cfg [ctor] .

  vars H : Hnd .  vars O : Op .  vars T : Tgt .

  --- Re-firings must not grow the soup.
  eq admitted(H, O, T) admitted(H, O, T) = admitted(H, O, T) .
  eq checkError checkError = checkError .

  --- CHECK ERROR 1: a narrowable operation named bare. The list is required.
  --- This deliberately does not prejudge the wildcard/unnarrowed grant
  --- spelling deferred in vnext -- when that lands, narrowable operations
  --- inherit it.
  crl [check-bare-narrowable] : grantBare(H, O)
    => grantBare(H, O) checkError
    if narrowable(O) .

  --- CHECK ERROR 2: a glob list on a non-narrowable operation. Rejected, not
  --- ignored: a clause that parses but binds nothing reads as a narrowing
  --- the runtime does not perform.
  crl [check-glob-on-bare-op] : grantList(H, O)
    => grantList(H, O) checkError
    if narrowable(O) = false .

  --- ADMISSION, narrowable class: the grant's list is consulted -- the
  --- attempt's target must be listed. There is deliberately no rule admitting
  --- a narrowable attempt whose target is not `listed`; that absence is the
  --- narrowing.
  crl [admit-narrowable] : attempt(H, O, T) grantList(H, O) listed(H, O, T)
    => grantList(H, O) listed(H, O, T) admitted(H, O, T)
    if narrowable(O) .

  --- ADMISSION, non-narrowable class: the bare grant admits the whole
  --- operation. `sign` has no natural glob -- a signed request narrows via
  --- `request`, and a standalone JWT has nothing to glob.
  crl [admit-bare] : attempt(H, O, T) grantBare(H, O)
    => grantBare(H, O) admitted(H, O, T)
    if narrowable(O) = false .
endm

--- NEGATIVE FIXTURE: the uniform-glob design section 14 rejects. One grant
--- shape, globs accepted everywhere, list consulted nowhere. Both failure
--- modes become reachable: a "narrowed" request admits targets outside its
--- list, and a glob on sign silently grants the whole operation while
--- reading as a restriction. This module exists so the main module's
--- No-solutions have content.
mod WHIPPLESCRIPT-CREDENTIAL-SCOPE-NARROWING-UNIFORM is
  sorts Op Hnd Tgt Cfg .

  ops reqOp mintOp signOp verifyOp wrapOp : -> Op [ctor] .
  ops h1 : -> Hnd [ctor] .
  ops tIn tOut : -> Tgt [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op grantList : Hnd Op -> Cfg [ctor] .
  op listed : Hnd Op Tgt -> Cfg [ctor] .
  op grantBare : Hnd Op -> Cfg [ctor] .
  op attempt : Hnd Op Tgt -> Cfg [ctor] .
  op admitted : Hnd Op Tgt -> Cfg [ctor] .

  vars H : Hnd .  vars O : Op .  vars T : Tgt .

  eq admitted(H, O, T) admitted(H, O, T) = admitted(H, O, T) .

  --- The uniform shape: any grant clause admits any attempt on its
  --- operation. The list is decoration.
  rl [admit-uniform-list] : attempt(H, O, T) grantList(H, O)
    => grantList(H, O) admitted(H, O, T) .
  rl [admit-uniform-bare] : attempt(H, O, T) grantBare(H, O)
    => grantBare(H, O) admitted(H, O, T) .
endm
