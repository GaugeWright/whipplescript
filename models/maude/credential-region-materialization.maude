--- Does Option A collapse into Option B?
---
--- The argument under test, stated during the DR-0074 discussion: effect
--- inputs are durable (`effects.input_json`), so an effect lowered inside a
--- region embeds plaintext in a durable record, violating the guarantee.
--- Rescuing that
--- means in-region effect inputs must carry the ENVELOPE and the worker opens
--- at execution time -- at which point, the argument ran, "the plaintext was
--- never really held as a binding, and the design has become Option B."
---
--- THE ARGUMENT IS WRONG, and this model is what shows it. The rescue removes
--- plaintext from durable records. It does not remove the BINDING, because a
--- binding lives in the interpreter during a rule pass and is not a durable
--- record. So there are three designs, not two:
---
---   A   naive: plaintext binding AND plaintext in effect inputs.
---       Violates the guarantee -- the durable outbox row holds the plaintext.
---   A'  rescued: plaintext binding for expression evaluation only; any value
---       crossing into a durable record is sealed or declassified first.
---       Preserves it, and whip can still evaluate over plaintext.
---   B   plaintext never enters whip's value space at all.
---
--- A' preserves the guarantee exactly as B does, and is STRICTLY MORE EXPRESSIVE: it can
--- evaluate a rule guard over sealed content and B cannot. The two theorems
--- that establish this are C3 and C4, run against the same fixture in
--- different modules -- one reaches `guardEvaluated`, the other cannot.
---
--- The general rule A' turns out to be is worth stating on its own, because it
--- is simpler than the region machinery it came from: ANY VALUE CROSSING FROM
--- INTERPRETER MEMORY INTO A DURABLE RECORD MUST BE SEALED OR DECLASSIFIED.
--- The exits themselves are modelled in credential-unwrap-confinement.maude
--- and credential-region-escape.maude and are not repeated here; this model
--- owns one question, which is where plaintext may be materialized.
---
--- Grounding:
---   sealedVal(V)            the envelope
---   bound(V)                plaintext in a whip binding -- interpreter memory
---   guardEvaluated(V)       whip evaluated an expression over plaintext
---   effectInputSealed(E,V)  the outbox row carries the envelope
---   effectInputOpened(E,V)  the outbox row carries plaintext
---   persistedCipher(V)      a durable record holds ciphertext -- always fine
---   persistedPlain(V)       a durable record holds plaintext -- the violation
---   runOpens(E,V)           the worker opened the envelope during the run
mod WHIPPLESCRIPT-CREDENTIAL-REGION-MATERIALIZATION is
  protecting BOOL .
  sorts Val Eff Cfg .

  op v1 : -> Val [ctor] .
  op e1 : -> Eff [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op custody : -> Cfg [ctor] .
  op sealedVal : Val -> Cfg [ctor] .
  op openReq : Val -> Cfg [ctor] .
  op bound : Val -> Cfg [ctor] .
  op guardReq : Val -> Cfg [ctor] .
  op guardEvaluated : Val -> Cfg [ctor] .
  op effectReq : Eff Val -> Cfg [ctor] .
  op effectInputSealed : Eff Val -> Cfg [ctor] .
  op effectInputOpened : Eff Val -> Cfg [ctor] .
  op persistedCipher : Val -> Cfg [ctor] .
  op persistedPlain : Val -> Cfg [ctor] .
  op runOpens : Eff Val -> Cfg [ctor] .

  var V : Val .  var E : Eff .

  eq bound(V) bound(V) = bound(V) .
  eq guardEvaluated(V) guardEvaluated(V) = guardEvaluated(V) .
  eq persistedCipher(V) persistedCipher(V) = persistedCipher(V) .
  eq persistedPlain(V) persistedPlain(V) = persistedPlain(V) .
  eq effectInputSealed(E, V) effectInputSealed(E, V) = effectInputSealed(E, V) .
  eq runOpens(E, V) runOpens(E, V) = runOpens(E, V) .

  --- Opening puts plaintext in a binding. This is Option A's premise, and A'
  --- keeps it -- a binding is interpreter state during a rule pass, not a
  --- durable record, so nothing about T3 objects to it yet.
  rl [open] : sealedVal(V) openReq(V) custody
    => sealedVal(V) openReq(V) custody bound(V) .

  --- ...and because the binding exists, whip can evaluate over it. This is
  --- the capability B does not have, and C3/C4 are about exactly this term.
  rl [guard] : bound(V) guardReq(V)
    => bound(V) guardReq(V) guardEvaluated(V) .

  --- A' S RULE. Lowering a value into an effect input SEALS it. The outbox
  --- row is durable, so this is the crossing where the general rule bites.
  rl [lower-sealed] : bound(V) effectReq(E, V) custody
    => bound(V) effectReq(E, V) custody effectInputSealed(E, V) .

  --- The outbox row is durable unconditionally. Under A' it holds ciphertext.
  rl [persist-input] : effectInputSealed(E, V)
    => effectInputSealed(E, V) persistedCipher(V) .

  --- The worker opens at execution time. Transient, inside one run, and never
  --- written back -- there is no rule from runOpens to any persisted term.
  rl [run] : effectInputSealed(E, V) custody
    => effectInputSealed(E, V) custody runOpens(E, V) .
endm

--- NEGATIVE FIXTURE 1: Option A as originally written. The binding is lowered
--- into the effect input as plaintext, and the outbox row is durable, so the
--- plaintext is persisted. This is the violation that motivated the rescue,
--- and it is real rather than hypothetical.
mod WHIPPLESCRIPT-CREDENTIAL-REGION-MATERIALIZATION-OPENED-INPUT is
  protecting BOOL .
  sorts Val Eff Cfg .

  op v1 : -> Val [ctor] .
  op e1 : -> Eff [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op custody : -> Cfg [ctor] .
  op sealedVal : Val -> Cfg [ctor] .
  op openReq : Val -> Cfg [ctor] .
  op bound : Val -> Cfg [ctor] .
  op guardReq : Val -> Cfg [ctor] .
  op guardEvaluated : Val -> Cfg [ctor] .
  op effectReq : Eff Val -> Cfg [ctor] .
  op effectInputOpened : Eff Val -> Cfg [ctor] .
  op persistedPlain : Val -> Cfg [ctor] .

  var V : Val .  var E : Eff .

  eq bound(V) bound(V) = bound(V) .
  eq guardEvaluated(V) guardEvaluated(V) = guardEvaluated(V) .
  eq persistedPlain(V) persistedPlain(V) = persistedPlain(V) .
  eq effectInputOpened(E, V) effectInputOpened(E, V) = effectInputOpened(E, V) .

  rl [open] : sealedVal(V) openReq(V) custody
    => sealedVal(V) openReq(V) custody bound(V) .

  rl [guard] : bound(V) guardReq(V)
    => bound(V) guardReq(V) guardEvaluated(V) .

  --- THE REJECTED LOWERING: the effect input carries plaintext.
  rl [lower-opened] : bound(V) effectReq(E, V)
    => bound(V) effectReq(E, V) effectInputOpened(E, V) .

  rl [persist-input] : effectInputOpened(E, V)
    => effectInputOpened(E, V) persistedPlain(V) .
endm

--- NEGATIVE FIXTURE 2: Option B. Plaintext never enters whip's value space;
--- an effect input is built directly from the envelope and only the worker
--- opens it. B is not unsafe -- it preserves T3 exactly as A' does -- so it is
--- a "negative" fixture only with respect to EXPRESSIVENESS. It is here to be
--- compared against A' on the same fixture, which is what C4 does.
mod WHIPPLESCRIPT-CREDENTIAL-REGION-MATERIALIZATION-NO-BINDING is
  protecting BOOL .
  sorts Val Eff Cfg .

  op v1 : -> Val [ctor] .
  op e1 : -> Eff [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op custody : -> Cfg [ctor] .
  op sealedVal : Val -> Cfg [ctor] .
  op openReq : Val -> Cfg [ctor] .
  op bound : Val -> Cfg [ctor] .
  op guardReq : Val -> Cfg [ctor] .
  op guardEvaluated : Val -> Cfg [ctor] .
  op effectReq : Eff Val -> Cfg [ctor] .
  op effectInputSealed : Eff Val -> Cfg [ctor] .
  op persistedCipher : Val -> Cfg [ctor] .
  op persistedPlain : Val -> Cfg [ctor] .
  op runOpens : Eff Val -> Cfg [ctor] .

  var V : Val .  var E : Eff .

  eq persistedCipher(V) persistedCipher(V) = persistedCipher(V) .
  eq effectInputSealed(E, V) effectInputSealed(E, V) = effectInputSealed(E, V) .
  eq runOpens(E, V) runOpens(E, V) = runOpens(E, V) .

  --- No rule produces bound(V). That absence IS Option B, and it is what the
  --- expressiveness theorems below detect -- there is nothing for `guard` to
  --- match on, so no rule for it exists either.

  rl [lower-sealed] : sealedVal(V) effectReq(E, V)
    => sealedVal(V) effectReq(E, V) effectInputSealed(E, V) .

  rl [persist-input] : effectInputSealed(E, V)
    => effectInputSealed(E, V) persistedCipher(V) .

  rl [run] : effectInputSealed(E, V) custody
    => effectInputSealed(E, V) custody runOpens(E, V) .
endm
