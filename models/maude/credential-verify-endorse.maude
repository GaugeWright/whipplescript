--- DR-0053 section 6: `verify` is an integrity raise, and specifically the
--- first CRYPTOGRAPHICALLY GROUNDED one.
---
--- Today `endorse` is an integrity raise authorized by a governance grant:
--- visible, audited, and ultimately a POLICY ASSERTION that some data is
--- trustworthy. A verified signature is the same raise with cryptographic
--- backing. So `verify` is not a new crossing -- it lowers to `endorse`, and
--- this model reuses WHIPPLESCRIPT-INFOFLOW-INTEGRITY's lattice verbatim --
--- deleg / canAct / influencedBy / controlSink / injection -- rather than
--- inventing a parallel vocabulary. That reuse IS the integration claim.
---
--- What the raise depends on, and therefore what this model checks:
---   the signature must actually match the credential   (keyed, not asserted)
---   the credential must be granted a vouching authority (governance)
---   the credential must be custodian-held                (custody, DR-0053 s2)
---   the payload must be within the bounded type          (I-IFC3 ceiling)
--- Drop any one and the raise must NOT happen -- the inbound content stays at
--- its arrival integrity and a control sink refuses it.
---
--- The failure branch is modelled honestly: a failed verify propagates the
--- ORIGINAL low influence to the output binding. That is the shape a sloppy
--- implementation would have (`after ... fails` reached, value still used),
--- and modelling it is what gives the success-path No-solution its content.
---
--- Grounding in the DR:
---   inbound(B, W)          a webhook body arriving at integrity W
---   signedWith(B, H)       the payload carries a signature made with H
---   granted(H, R)          governance grants H, vouching authority R
---   sealed(H)              the custodian holds H
---   bounded(B, T)          B is within bounded type T
---   verify(B1, B2, H, T)   `verify B1 with H into T as B2`
---   controlSink(B, R)      a control point requiring authority R
mod WHIPPLESCRIPT-CREDENTIAL-VERIFY-ENDORSE is
  protecting BOOL .
  sorts Prin PSet Edge Rel Binding Hnd Typ Cfg .
  subsort Prin < PSet .
  subsort Edge < Rel .

  ops operator manager clerk stranger : -> Prin [ctor] .
  ops b1 b2 b3 : -> Binding [ctor] .
  ops h1 h2 : -> Hnd [ctor] .
  ops t1 t2 : -> Typ [ctor] .

  op noP : -> PSet [ctor] .
  op _,_ : PSet PSet -> PSet [ctor assoc comm id: noP] .
  eq P:Prin , P:Prin = P:Prin .

  op _>_ : Prin Prin -> Edge [ctor] .
  op emptyR : -> Rel [ctor] .
  op _|_ : Rel Rel -> Rel [ctor assoc comm id: emptyR] .
  eq E:Edge | E:Edge = E:Edge .

  --- acts-for closure, reflexive-transitive, with a visited set so cycles end.
  --- Identical to infoflow-integrity: the lattice is shared, not re-derived.
  op inSet : Prin PSet -> Bool .
  eq inSet(P:Prin, (P:Prin , S:PSet)) = true .
  eq inSet(P:Prin, S:PSet) = false [owise] .

  op succs : Prin Rel -> PSet .
  eq succs(P:Prin, (P:Prin > Q:Prin) | R:Rel) = Q:Prin , succs(P:Prin, R:Rel) .
  eq succs(P:Prin, R:Rel) = noP [owise] .

  op canAct : Rel Prin Prin -> Bool .
  op reach : Rel PSet Prin PSet -> Bool .
  eq canAct(R:Rel, W:Prin, T:Prin) = reach(R:Rel, W:Prin, T:Prin, noP) .
  eq reach(R:Rel, (T:Prin , F:PSet), T:Prin, V:PSet) = true .
  eq reach(R:Rel, noP, T:Prin, V:PSet) = false .
  ceq reach(R:Rel, (P:Prin , F:PSet), T:Prin, V:PSet)
    = reach(R:Rel, F:PSet, T:Prin, V:PSet)
    if P:Prin =/= T:Prin /\ inSet(P:Prin, V:PSet) .
  ceq reach(R:Rel, (P:Prin , F:PSet), T:Prin, V:PSet)
    = reach(R:Rel, (F:PSet , succs(P:Prin, R:Rel)), T:Prin, (P:Prin , V:PSet))
    if P:Prin =/= T:Prin /\ inSet(P:Prin, V:PSet) =/= true .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op deleg : Rel -> Cfg [ctor] .
  op inbound : Binding Prin -> Cfg [ctor] .
  op influencedBy : Binding Prin -> Cfg [ctor] .
  op flow : Binding Binding -> Cfg [ctor] .
  op signedWith : Binding Hnd -> Cfg [ctor] .
  op granted : Hnd Prin -> Cfg [ctor] .
  op sealed : Hnd -> Cfg [ctor] .
  op bounded : Binding Typ -> Cfg [ctor] .
  op verify : Binding Binding Hnd Typ -> Cfg [ctor] .
  op verified : Binding Prin -> Cfg [ctor] .
  op verifyFailed : Binding -> Cfg [ctor] .
  op controlSink : Binding Prin -> Cfg [ctor] .
  op injection : -> Cfg [ctor] .

  vars B B1 B2 : Binding .  vars W R : Prin .  var REL : Rel .
  vars H HS : Hnd .  vars T TB : Typ .

  eq influencedBy(B, W) influencedBy(B, W) = influencedBy(B, W) .
  eq verified(B, R) verified(B, R) = verified(B, R) .
  eq verifyFailed(B) verifyFailed(B) = verifyFailed(B) .
  eq injection injection = injection .

  rl [seed] : inbound(B, W) => inbound(B, W) influencedBy(B, W) .

  rl [prop] : influencedBy(B1, W) flow(B1, B2)
    => influencedBy(B1, W) flow(B1, B2) influencedBy(B2, W) .

  --- THE RAISE. Every conjunct is load-bearing: the signature matches the
  --- named credential, governance grants that credential a vouching authority,
  --- the custodian holds it, and the payload is within the declared ceiling.
  --- The output carries ONLY the vouching authority's influence -- the inbound
  --- taint does not cross, which is what makes this an endorse.
  crl [verify-ok] : verify(B1, B2, H, T) signedWith(B1, HS) granted(H, R)
                    sealed(H) bounded(B1, TB)
    => verify(B1, B2, H, T) signedWith(B1, HS) granted(H, R) sealed(H)
       bounded(B1, TB) verified(B2, R) influencedBy(B2, R)
    if HS == H /\ TB == T .

  --- The failure branch is a MARKER only. It deliberately produces no
  --- influence on B2: on a failed verify whip takes `after ... fails` and the
  --- output binding is never bound, so there is nothing for the low taint to
  --- ride. Modelling a failed verify as "B2 inherits the inbound influence"
  --- would be modelling a different program -- one that uses the raw value --
  --- and would conflate "the raise did not happen" with "bad data flowed".
  --- Those are checked separately below: the raise-dependency searches ask
  --- whether verified(B2, R) is producible at all, and the injection searches
  --- ask whether tainted data reaches a sink.
  crl [verify-fail] : verify(B1, B2, H, T) signedWith(B1, HS)
    => verify(B1, B2, H, T) signedWith(B1, HS) verifyFailed(B2)
    if HS =/= H .

  crl [inject] : influencedBy(B, W) controlSink(B, R) deleg(REL)
    => influencedBy(B, W) controlSink(B, R) deleg(REL) injection
    if canAct(REL, W, R) =/= true .
endm
