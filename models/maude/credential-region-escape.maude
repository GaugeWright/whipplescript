--- DR-0074 §3.1: no in-region binding reaches an ordinary value slot except
--- through the two exits of §5.
---
--- DR-0074 §4 says where plaintext may be WRITTEN: never into a durable record,
--- only into interpreter memory. It says nothing about how long the binding
--- LASTS. That is the gap this closes, and it matters more than it first
--- sounds, because escape does not violate §4 locally. It defeats §4 by
--- outliving the region: once an opened value is ordinary held data at its
--- sealed label, every later check treats it as ordinary governed data, and a
--- durable record accepts it with every rule satisfied. So §3.1 is not scope
--- hygiene -- it is what makes §4 hold across time rather than at one instant,
--- and theorem E3 below re-derives the violation through the escape route to
--- say so.
---
--- An earlier cut of this model carried a fourth theorem, E2, asserting that a
--- handler attached to an in-region effect never binds plaintext "once the
--- region has closed". It rested on the premise that an `after` block executes
--- in a later rule commit. That premise is false. execution-contract.md states
--- that `after` is durable dependency sugar which does not preserve a stack
--- frame or execute arbitrary code later: its effects are created in the SAME
--- commit and blocked on a dependency. There is no close event for a handler to
--- fire after, so E2 described a transition whip does not have, and it was
--- withdrawn rather than repaired. DR-0074's Open section carries what actually
--- remains of the question.
---
--- Grounding:
---   regionOpen(R) / regionClosed(R)  the region's extent; `close` CONSUMES open
---   inRegion(V, L, R)                plaintext bound inside region R
---   holds(V, L)                      ordinary held data -- the escape marker
---   sealedVal(V, L)                  ciphertext, exit 2's product
---   persistedPlain(V, L)             plaintext reached the durable fact base
mod WHIPPLESCRIPT-CREDENTIAL-REGION-ESCAPE is
  protecting BOOL .
  sorts Val Label Rgn Cfg .

  ops v1 v2 : -> Val [ctor] .
  ops secret public : -> Label [ctor] .
  op r1 : -> Rgn [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op regionOpen : Rgn -> Cfg [ctor] .
  op regionClosed : Rgn -> Cfg [ctor] .
  op inRegion : Val Label Rgn -> Cfg [ctor] .
  op holds : Val Label -> Cfg [ctor] .
  op sealedVal : Val Label -> Cfg [ctor] .
  op custody : -> Cfg [ctor] .
  op grantDeclassify : -> Cfg [ctor] .
  op closeReq : Rgn -> Cfg [ctor] .
  op deriveReq : Val Val -> Cfg [ctor] .
  op declassifyReq : Val -> Cfg [ctor] .
  op resealReq : Val -> Cfg [ctor] .
  op sinkReq : Val -> Cfg [ctor] .
  op persistedPlain : Val Label -> Cfg [ctor] .

  vars V W : Val .  var L : Label .  var R : Rgn .

  eq holds(V, L) holds(V, L) = holds(V, L) .
  eq inRegion(V, L, R) inRegion(V, L, R) = inRegion(V, L, R) .
  eq sealedVal(V, L) sealedVal(V, L) = sealedVal(V, L) .
  eq persistedPlain(V, L) persistedPlain(V, L) = persistedPlain(V, L) .

  --- Closing CONSUMES the open marker. Every rule that acts on an in-region
  --- value requires it, so after close the binding is inert -- which is what
  --- confinement means operationally.
  rl [close] : regionOpen(R) closeReq(R) => regionClosed(R) .

  --- Derived values inherit the region, and derivation itself is in-region
  --- work: it cannot happen once the region has closed.
  rl [derive] : regionOpen(R) inRegion(V, L, R) deriveReq(V, W)
    => regionOpen(R) inRegion(V, L, R) deriveReq(V, W) inRegion(W, L, R) .

  --- EXIT 1: a granted declassify, INSIDE the region. Its product is ordinary
  --- held data at the grant's audience and legitimately outlives the region.
  rl [declassify] : regionOpen(R) inRegion(V, L, R) declassifyReq(V) grantDeclassify
    => regionOpen(R) inRegion(V, L, R) declassifyReq(V) grantDeclassify
       holds(V, public) .

  --- EXIT 2: re-seal, INSIDE the region. Ciphertext outlives it too.
  rl [reseal] : regionOpen(R) inRegion(V, L, R) resealReq(V) custody
    => regionOpen(R) inRegion(V, L, R) resealReq(V) custody sealedVal(V, L) .

  --- Ordinary held data reaches a durable record. No clearance test here: §4
  --- makes clearance the wrong question, since a durable record refuses
  --- plaintext however well cleared it is.
  rl [persist] : holds(V, L) sinkReq(V) => holds(V, L) sinkReq(V) persistedPlain(V, L) .
endm

--- NEGATIVE FIXTURE. The design in which `open` MARKS a value rather than
--- BINDING it: the sink checks of the confinement model are all present and
--- all pass, but the binding simply survives the region and becomes ordinary
--- held data at its sealed label.
---
--- This is the plausible weak implementation, not a strawman. A checker that
--- validates what happens inside the braces and then stops has exactly this
--- behaviour: every crossing it saw obeyed §4. The violation lands entirely
--- after the closing brace.
mod WHIPPLESCRIPT-CREDENTIAL-REGION-ESCAPE-ESCAPING is
  protecting BOOL .
  sorts Val Label Rgn Cfg .

  ops v1 v2 : -> Val [ctor] .
  ops secret public : -> Label [ctor] .
  op r1 : -> Rgn [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op regionOpen : Rgn -> Cfg [ctor] .
  op regionClosed : Rgn -> Cfg [ctor] .
  op inRegion : Val Label Rgn -> Cfg [ctor] .
  op holds : Val Label -> Cfg [ctor] .
  op closeReq : Rgn -> Cfg [ctor] .
  op deriveReq : Val Val -> Cfg [ctor] .
  op sinkReq : Val -> Cfg [ctor] .
  op persistedPlain : Val Label -> Cfg [ctor] .

  vars V W : Val .  var L : Label .  var R : Rgn .

  eq holds(V, L) holds(V, L) = holds(V, L) .
  eq inRegion(V, L, R) inRegion(V, L, R) = inRegion(V, L, R) .
  eq persistedPlain(V, L) persistedPlain(V, L) = persistedPlain(V, L) .

  rl [close] : regionOpen(R) closeReq(R) => regionClosed(R) .

  rl [derive] : inRegion(V, L, R) deriveReq(V, W)
    => inRegion(V, L, R) deriveReq(V, W) inRegion(W, L, R) .

  --- THE REJECTED SEMANTICS: the binding outlives the region.
  rl [survive] : inRegion(V, L, R) regionClosed(R)
    => inRegion(V, L, R) regionClosed(R) holds(V, L) .

  rl [persist] : holds(V, L) sinkReq(V) => holds(V, L) sinkReq(V) persistedPlain(V, L) .
endm
