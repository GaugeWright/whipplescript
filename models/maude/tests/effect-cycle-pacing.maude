load ../effect-cycle-pacing.maude

--- Coverage: a same-commit cycle carrying an effect is rejected. Nothing paces
--- it, so each turn enqueues fresh effects at the speed of the store.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  sameCommit(ra, rb) sameCommit(rb, ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* C:Cfg rejected(ra & RS:RuleSet) .

--- Coverage: the SELF-edge form of that same shape is rejected too -- a loop
--- spelled in one rule is the loop of two rules with fewer names.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  sameCommit(ra, ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* C:Cfg rejected(ra & RS:RuleSet) .

--- Coverage: the same ring, every edge waiting on an effect terminal, is
--- rejected under the bounded declaration -- a workflow that promises to settle
--- may not loop with the world either.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  bounded paced(ra, rb) paced(rb, ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* C:Cfg rejected(ra & RS:RuleSet) .

--- Coverage: @tool reaches that refusal without the tag, and it reaches the
--- one-rule form of it -- the shape that blocks an agent turn for as long as the
--- model keeps answering.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  tool paced(ra, ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* C:Cfg rejected(ra & RS:RuleSet) .

--- Bite: a paced ring WITHOUT either declaration is never rejected. This is the
--- long-running agent loop, legal with no tag at all.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  paced(ra, rb) paced(rb, ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Bite: the paced SELF-loop is never rejected either, which is the retry idiom
--- of docs/manual/13-agent-patterns.md: it advances its trigger behind an after.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  paced(ra, ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Bite: a rule that records its own trigger without consuming it is never
--- rejected HERE. The per-rule refusal owns that defect, and one defect earns
--- one diagnostic.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  preservedSelf(ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Bite: a ring that closes only through a paced edge is never rejected. One
--- wait on the world paces the whole ring, so a same-commit edge elsewhere on it
--- is not enough to refuse.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  sameCommit(ra, rb) paced(rb, ra) effectful(ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Bite: an effect-free same-commit cycle is never rejected -- pure monotonic
--- recursion stays allowed.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  sameCommit(ra, rb) sameCommit(rb, ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Bite: a bounded workflow whose effects form a chain rather than a ring is
--- never rejected. The declaration refuses a cycle, not effects.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  bounded paced(ra, rb) paced(rb, rc) effectful(ra) effectful(rb) effectful(rc)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Coverage: an UNMEASURED effect-free ring is rejected under the declaration.
--- Nothing is enqueued and no effect rides it, yet the ring turns inside the
--- pass and nothing proves it stops, so the workflow does not settle in any
--- number of steps the program fixes.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  bounded unmeasured(ra) sameCommit(ra, rb) sameCommit(rb, ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* C:Cfg rejected(ra & RS:RuleSet) .

--- Bite: the SAME ring with a measure is never rejected. A ring that provably
--- cannot turn forever settles, which is all the declaration asked for — this
--- is what keeps the refusal from being the pre-pacing mistake in another form.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  bounded sameCommit(ra, rb) sameCommit(rb, ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Bite: the same unmeasured ring WITHOUT the declaration is never rejected.
--- Pure monotonic recursion stays allowed where nothing promised it settles.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  unmeasured(ra) sameCommit(ra, rb) sameCommit(rb, ra)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .

--- Bite: an unmeasured effect-free CHAIN under the declaration is never
--- rejected. The refusal names a RING, not the absence of a measure.
search [1] in WHIPPLESCRIPT-EFFECT-CYCLE-PACING :
  bounded unmeasured(ra) sameCommit(ra, rb) sameCommit(rb, rc)
  counted(mtPairs) reaches(mtPairs) rejected(mtRules)
  =>* rejected(R:Rule & RS:RuleSet) RESIDUAL:Cfg .
