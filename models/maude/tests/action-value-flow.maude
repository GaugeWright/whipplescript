search [1] in WHIPPLESCRIPT-ACTION-VALUE-FLOW : inspect(selected(true, input(false))) =>* flow(false, true, false) .
search [1] in WHIPPLESCRIPT-ACTION-VALUE-FLOW : inspect(owned(input(false))) =>* flow(false, false, true) .
search [1] in WHIPPLESCRIPT-ACTION-VALUE-FLOW : inspect(alias(input(true))) =>* flow(false, false, false) .
