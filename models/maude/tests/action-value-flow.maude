search [1] in WHIPPLESCRIPT-ACTION-VALUE-FLOW : inspect(owned(input(false))) =>* flow(true, false, true) .
search [1] in WHIPPLESCRIPT-ACTION-VALUE-LOST : inspect(owned(input(false))) =>* flow(true, false, true) .
search [1] in WHIPPLESCRIPT-ACTION-VALUE-FLOW : inspect(unknown) =>* flow(false, false, false) .
search [1] in WHIPPLESCRIPT-ACTION-VALUE-LOST : inspect(unknown) =>* flow(false, false, false) .
