search [1] in WHIPPLESCRIPT-ACTION-VALUE-LOST : inspect(cyclic) =>* flow(false, false, false) .
--- Clean exit controls a public constant without becoming its payload.
search [1] in WHIPPLESCRIPT-ACTION-VALUE-FLOW : inspect(postExit(true, input(false))) =>* flow(false, true, false) .
search [1] in WHIPPLESCRIPT-ACTION-VALUE-FLOW : inspect(postExit(true, input(false))) =>* flow(false, false, false) .
search [1] in WHIPPLESCRIPT-ACTION-VALUE-LOST : inspect(postExit(true, input(false))) =>* flow(false, false, false) .
