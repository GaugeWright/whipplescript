search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, openedFingerprint) lowerReq(second, v1, n1, pB, openedFingerprint)
  =>* depDiff REST:Cfg .

