load ../credential-fingerprint-containment.maude

--- Reachable recording: actual custody and type admission precede lowering. Expected S.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly)
  =>* recorded(first, n1, fpIdentity(v1, secret, tPatient, n1), depIdentity(v1, secret, tPatient)) REST:Cfg .

--- Nonvacuity: both transient inputs really lower to identical public observations. Expected S.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v1, n1, pB, identityOnly)
  =>* recorded(first, n1, fpIdentity(v1, secret, tPatient, n1), depIdentity(v1, secret, tPatient)) recorded(second, n1, fpIdentity(v1, secret, tPatient, n1), depIdentity(v1, secret, tPatient)) REST:Cfg .

--- Fingerprint independence from opened expression input. Expected N.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v1, n1, pB, identityOnly)
  =>* fpDiff REST:Cfg .

--- Dependency commitment independence, separately from fingerprint. Expected N.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v1, n1, pB, identityOnly)
  =>* depDiff REST:Cfg .

--- Re-seal identity changes BOTH commitments: safe false miss, not accidental normalization. Expected S.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) sealedVal(v2, secret, tPatient, h1) openReq(v2, tPatient) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v2, n1, pA, identityOnly)
  =>* fpDiff depDiff REST:Cfg .

--- Label belongs to the public identity context. Expected S.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) sealedVal(v1, public, tPatient, h1) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v1, n1, pA, identityOnly)
  =>* recorded(first, n1, fpIdentity(v1, secret, tPatient, n1), depIdentity(v1, secret, tPatient)) recorded(second, n1, fpIdentity(v1, public, tPatient, n1), depIdentity(v1, public, tPatient)) fpDiff depDiff REST:Cfg .

--- Type belongs to the public identity context; both grants are admitted. Expected S.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) sealedVal(v1, secret, tBilling, h1) grantUnwrap(h1, tBilling) openReq(v1, tBilling) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v1, n1, pA, identityOnly)
  =>* recorded(first, n1, fpIdentity(v1, secret, tPatient, n1), depIdentity(v1, secret, tPatient)) recorded(second, n1, fpIdentity(v1, secret, tBilling, n1), depIdentity(v1, secret, tBilling)) fpDiff depDiff REST:Cfg .

--- Effect node identity changes the execution fingerprint. Expected S.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v1, n2, pA, identityOnly)
  =>* fpDiff REST:Cfg .

--- Changing consumer node does not change the same dependency output identity. Expected N.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly) lowerReq(second, v1, n2, pA, identityOnly)
  =>* depDiff REST:Cfg .

--- No custody: lowering cannot seed a recording. Expected N.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly)
  =>* recorded(first, n1, F:Digest, D:Digest) REST:Cfg .

--- Wrong granted type: lowering cannot seed a recording. Expected N.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tBilling) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly)
  =>* recorded(first, n1, F:Digest, D:Digest) REST:Cfg .

--- identityOnly: actual observer guesses both candidates; fingerprint confirmation split. Expected N.
search [1] in WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT :
  custody(h1) sealedVal(v1, secret, tPatient, h1) grantUnwrap(h1, tPatient) openReq(v1, tPatient) lowerReq(first, v1, n1, pA, identityOnly) guessReq(first, pA) guessReq(first, pB)
  =>* answer(first, fingerprint, true) answer(first, fingerprint, false) REST:Cfg .

