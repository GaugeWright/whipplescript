--- DR-0074 SS8: a symbolic lowering witness, NOT a runtime custody model.
--- Import the existing admission/region rules so recording must be reachable
--- through custody and a type-matched grant, rather than a seeded observation.
--- Hash constructors are collision-free symbolic abstractions: this proves
--- input dependence, not cryptographic collision resistance or AEAD integrity.
--- pA/pB range over transient expression inputs for a dependence experiment;
--- they do not assert two valid plaintexts for one actual AEAD ciphertext.
load credential-unwrap-confinement.maude

mod WHIPPLESCRIPT-CREDENTIAL-FINGERPRINT-CONTAINMENT is
  including WHIPPLESCRIPT-CREDENTIAL-UNWRAP-CONFINEMENT .
  sorts Payload Node Tag Mode Digest Channel .
  ops pA pB : -> Payload [ctor] .
  ops n1 n2 : -> Node [ctor] .
  ops first second : -> Tag [ctor] .
  ops identityOnly openedFingerprint openedDependencies : -> Mode [ctor] .
  ops fingerprint dependency : -> Channel [ctor] .
  --- Val is the existing model's opaque envelope identity, not its bytes.
  op fpIdentity : Val Label Ty Node -> Digest [ctor] .
  --- One resolved dependency output's commitment, not the consumer's whole
  --- ordered dependency vector. Its envelope id/label/type are retained;
  --- the consumer effect_node_id belongs to fpIdentity, not to this output.
  --- Sorted upstream effect ids from execution-contract.md are held fixed in
  --- this dependence experiment; no vector assembly/order claim is made.
  op depIdentity : Val Label Ty -> Digest [ctor] .
  op fpOpened : Payload Node -> Digest [ctor] .
  op depOpened : Payload -> Digest [ctor] .
  op fingerprintOf : Mode Val Label Ty Node Payload -> Digest .
  op dependencyOf : Mode Val Label Ty Payload -> Digest .
  op lowerReq : Tag Val Node Payload Mode -> Cfg [ctor] .
  op recorded : Tag Node Digest Digest -> Cfg [ctor] .
  ops fpDiff depDiff : -> Cfg [ctor] .
  op guessReq : Tag Payload -> Cfg [ctor] .
  op answer : Tag Channel Bool -> Cfg [ctor] .

  vars V : Val . var L : Label . var T : Ty . var H : Hnd .
  vars P G : Payload . var N : Node . var K : Tag . var M : Mode .
  vars F D F2 D2 : Digest . var N2 : Node .

  eq fingerprintOf(identityOnly, V, L, T, N, P) = fpIdentity(V, L, T, N) .
  eq fingerprintOf(openedDependencies, V, L, T, N, P) = fpIdentity(V, L, T, N) .
  eq fingerprintOf(openedFingerprint, V, L, T, N, P) = fpOpened(P, N) .
  eq dependencyOf(identityOnly, V, L, T, P) = depIdentity(V, L, T) .
  eq dependencyOf(openedFingerprint, V, L, T, P) = depIdentity(V, L, T) .
  eq dependencyOf(openedDependencies, V, L, T, P) = depOpened(P) .

  --- Consumes the request: finite state space, and no recording without the
  --- actual region produced by the imported admission transition. Plaintext
  --- expression inputs are transient requests, absent from recorded markers.
  rl [lower] : sealedVal(V, L, T, H) inRegion(V, L, T) lowerReq(K, V, N, P, M)
    => sealedVal(V, L, T, H) inRegion(V, L, T)
       recorded(K, N, fingerprintOf(M, V, L, T, N, P), dependencyOf(M, V, L, T, P)) .
  eq fpDiff fpDiff = fpDiff .
  eq depDiff depDiff = depDiff .
  eq answer(K, fingerprint, true) answer(K, fingerprint, true) = answer(K, fingerprint, true) .
  eq answer(K, fingerprint, false) answer(K, fingerprint, false) = answer(K, fingerprint, false) .
  eq answer(K, dependency, true) answer(K, dependency, true) = answer(K, dependency, true) .
  eq answer(K, dependency, false) answer(K, dependency, false) = answer(K, dependency, false) .
  crl [compare-fingerprint] : recorded(first, N, F, D) recorded(second, N2, F2, D2)
    => recorded(first, N, F, D) recorded(second, N2, F2, D2) fpDiff if F =/= F2 .
  crl [compare-dependencies] : recorded(first, N, F, D) recorded(second, N2, F2, D2)
    => recorded(first, N, F, D) recorded(second, N2, F2, D2) depDiff if D =/= D2 .
  --- An observer compares a guessed opened-content hash with the public
  --- commitment. A split true/false answer confirms a secret candidate.
  rl [guess-fingerprint] : recorded(K, N, F, D) guessReq(K, G)
    => recorded(K, N, F, D) guessReq(K, G) answer(K, fingerprint, F == fpOpened(G, N)) .
  rl [guess-dependencies] : recorded(K, N, F, D) guessReq(K, G)
    => recorded(K, N, F, D) guessReq(K, G) answer(K, dependency, D == depOpened(G)) .
endm
