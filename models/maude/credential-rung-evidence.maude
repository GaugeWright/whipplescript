--- DR-0053 section 4: the seal rung is DERIVED FROM EVIDENCE, never asserted.
---
--- This is what makes `require credential <rung>` a control rather than a
--- self-assessment. The custody TLA model takes `sealedAt` as given and proves
--- what follows from it; this model proves where it comes from, and is the
--- companion that stops that assumption from being load-bearing.
---
--- The ladder mirrors the MCP trust ladder deliberately -- same shape, same
--- discipline that the rung is read off evidence and the floor lives in the
--- signed policy, so provisioning a credential cannot also lower the bar it is
--- judged against.
---
---   r0 process      the floor. No evidence required, and none can be
---                   missing -- a credential with nothing to show IS r0,
---                   tagged degraded, rather than unknown or assumed-good.
---   r1 os-keyring   the keyring holds the item.
---   r2 hardware     a TPM quote FRESH against current PCRs, or a PKCS#11
---                   token whose key is marked non-extractable.
---   r3 remote       an authenticated remote custodian attestation.
---
--- Two things carry the real weight, and both are the substance of the rung
--- rather than its label:
---
---   FRESHNESS. A TPM quote is bound to the PCR state it was taken against. A
---   firmware or kernel update moves the PCRs and the quote stops counting --
---   the operational failure DR-0053 flags under Consequences. A model that
---   let a stale quote stand would bless exactly the case that breaks in
---   production.
---
---   NON-EXTRACTABILITY. r2 does not mean "hardware is present", it means the
---   key cannot leave. A PKCS#11 token holding an extractable key is hardware
---   that fails the only property the rung is about.
---
--- Grounding in the DR:
---   cred(H)              a declared credential
---   claims(H, R)         what operator CONFIG says the rung is
---   derived(H, R)        what the evidence actually supports
---   envelopeMin(R)       `require credential <rung>` from the signed policy
---   admitted(H)          a use cleared the floor
mod WHIPPLESCRIPT-CREDENTIAL-RUNG-EVIDENCE is
  protecting BOOL .
  protecting NAT .

  sorts Hnd Rung Pcr Extract Cfg .

  ops h1 h2 : -> Hnd [ctor] .
  ops r0 r1 r2 r3 : -> Rung [ctor] .
  ops pcrA pcrB : -> Pcr [ctor] .
  ops extractable nonExtractable : -> Extract [ctor] .

  op level : Rung -> Nat .
  eq level(r0) = 0 .
  eq level(r1) = 1 .
  eq level(r2) = 2 .
  eq level(r3) = 3 .
  op geq : Rung Rung -> Bool .
  eq geq(A:Rung, B:Rung) = level(A:Rung) >= level(B:Rung) .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op cred : Hnd -> Cfg [ctor] .
  op claims : Hnd Rung -> Cfg [ctor] .
  op derived : Hnd Rung -> Cfg [ctor] .
  op envelopeMin : Rung -> Cfg [ctor] .
  op admitted : Hnd -> Cfg [ctor] .
  op degraded : Hnd -> Cfg [ctor] .

  --- Evidence.
  op keyringPresent : Hnd -> Cfg [ctor] .
  op tpmQuote : Hnd Pcr -> Cfg [ctor] .
  op currentPcr : Pcr -> Cfg [ctor] .
  op pkcs11Token : Hnd Extract -> Cfg [ctor] .
  op remoteAttest : Hnd -> Cfg [ctor] .

  vars H : Hnd .  vars R M : Rung .  vars P Q : Pcr .  vars E : Extract .

  eq derived(H, R) derived(H, R) = derived(H, R) .
  eq admitted(H) admitted(H) = admitted(H) .
  eq degraded(H) degraded(H) = degraded(H) .

  --- r0 is the floor and needs no evidence. Crucially there is NO rule taking
  --- claims(H, R) to derived(H, R): configuration is not evidence, and that
  --- absence is the theorem. A credential resting on r0 is tagged degraded so
  --- the weakness is visible rather than silent.
  rl [derive-r0] : cred(H) => cred(H) derived(H, r0) degraded(H) .

  rl [derive-r1] : keyringPresent(H) => keyringPresent(H) derived(H, r1) .

  --- FRESHNESS: the quote counts only against the PCR state it was taken
  --- against. Move the PCRs -- a firmware or kernel update -- and it stops.
  crl [derive-r2-tpm] : tpmQuote(H, P) currentPcr(Q)
    => tpmQuote(H, P) currentPcr(Q) derived(H, r2)
    if P == Q .

  --- NON-EXTRACTABILITY: hardware that lets the key out is not rung 2.
  crl [derive-r2-pkcs11] : pkcs11Token(H, E)
    => pkcs11Token(H, E) derived(H, r2)
    if E == nonExtractable .

  rl [derive-r3] : remoteAttest(H) => remoteAttest(H) derived(H, r3) .

  --- Admission compares the envelope floor against the DERIVED rung. The floor
  --- comes from the signed policy and nothing here can move it.
  crl [admit] : cred(H) derived(H, R) envelopeMin(M)
    => cred(H) derived(H, R) envelopeMin(M) admitted(H)
    if geq(R, M) .
endm

--- NEGATIVE FIXTURE. The rejected design in which operator configuration is
--- believed: a credential that SAYS it is hardware-sealed is treated as
--- hardware-sealed. This is precisely the self-assessment that
--- `require credential <rung>` would become if the rung were declared rather
--- than derived, and it exists so the main module's No-solution results have
--- demonstrated content.
mod WHIPPLESCRIPT-CREDENTIAL-RUNG-EVIDENCE-DECLARED is
  protecting BOOL .
  protecting NAT .

  sorts Hnd Rung Cfg .

  ops h1 h2 : -> Hnd [ctor] .
  ops r0 r1 r2 r3 : -> Rung [ctor] .

  op level : Rung -> Nat .
  eq level(r0) = 0 .
  eq level(r1) = 1 .
  eq level(r2) = 2 .
  eq level(r3) = 3 .
  op geq : Rung Rung -> Bool .
  eq geq(A:Rung, B:Rung) = level(A:Rung) >= level(B:Rung) .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op cred : Hnd -> Cfg [ctor] .
  op claims : Hnd Rung -> Cfg [ctor] .
  op derived : Hnd Rung -> Cfg [ctor] .
  op envelopeMin : Rung -> Cfg [ctor] .
  op admitted : Hnd -> Cfg [ctor] .

  vars H : Hnd .  vars R M : Rung .

  eq derived(H, R) derived(H, R) = derived(H, R) .
  eq admitted(H) admitted(H) = admitted(H) .

  --- THE REJECTED RULE: configuration taken as evidence.
  rl [trust-config] : claims(H, R) => claims(H, R) derived(H, R) .

  crl [admit] : cred(H) derived(H, R) envelopeMin(M)
    => cred(H) derived(H, R) envelopeMin(M) admitted(H)
    if geq(R, M) .
endm
