--- DR-0053: envelope encryption as a LABEL-CARRYING boundary.
---
--- `wrap`/`unwrap` lets whip persist data it cannot read: the custodian holds
--- the wrapping key, whip holds only ciphertext. That makes it a new
--- persistence boundary, and infoflow-carriage.maude's rule applies without
--- exception -- NO BOUNDARY LAUNDERS A LABEL. If unwrapped data came back
--- unlabelled, wrap -> store -> unwrap would be a laundering path in exactly
--- the family DR-0045 (unlabeled-fact laundering), DR-0046 (effect outputs as
--- governed writers) and DR-0051 (tracker ingress) were each accepted to
--- close. The ruling modelled here: THE ENVELOPE RECORDS THE LABEL AND UNWRAP
--- RESTORES IT.
---
--- One thing is deliberately different from every other operation in the
--- custody vocabulary, and is worth stating so the custody claim is not
--- misread. `unwrap` legitimately returns PLAINTEXT to whip. That is correct:
--- the wrapped data is ordinary, possibly governed, application data -- not
--- credential material. The custodian holds only the WRAPPING KEY. So this
--- boundary does not strengthen NoPlaintextInWhip, and the model keeps the two
--- notions apart: keyMaterial(H) may never reach whip, while the wrapped value
--- may and must.
---
--- The second property is AEAD context binding. A wrapped envelope is bound to
--- the context it was produced for; unwrapping it elsewhere must refuse.
--- Without that, ciphertexts are swappable between contexts and whip unwraps
--- blob A believing it is blob B -- a confused deputy that label carriage does
--- not catch, because both blobs may be perfectly well labelled.
---
--- Grounding in the DR:
---   holds(V, L)            whip holds value V at label L
---   origin(V, L)           the label V started at, for laundering detection
---   wrapReq(V, H, C)       `wrap V under credential H` in context C
---   envelope(V, L, H, C)   the ciphertext, carrying label AND context
---   unwrapReq(V, H, C)     an attempt to unwrap in context C
---   sealed(H)              the custodian holds the wrapping key
---   keyMaterial(H)         the wrapping key's bytes; never at whip
mod WHIPPLESCRIPT-CREDENTIAL-WRAP-CARRIAGE is
  protecting BOOL .
  sorts Val Label Ctx Hnd Cfg .

  ops v1 v2 : -> Val [ctor] .
  ops secret public : -> Label [ctor] .
  ops ctxA ctxB : -> Ctx [ctor] .
  ops h1 h2 : -> Hnd [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op holds : Val Label -> Cfg [ctor] .
  op origin : Val Label -> Cfg [ctor] .
  op wrapReq : Val Hnd Ctx -> Cfg [ctor] .
  op envelope : Val Label Hnd Ctx -> Cfg [ctor] .
  op unwrapReq : Val Hnd Ctx -> Cfg [ctor] .
  op unwrapped : Val Label -> Cfg [ctor] .
  op refused : Val -> Cfg [ctor] .
  op sealed : Hnd -> Cfg [ctor] .
  op keyMaterial : Hnd -> Cfg [ctor] .
  op laundered : -> Cfg [ctor] .
  op confused : -> Cfg [ctor] .

  vars V : Val .  vars L : Label .  vars C D : Ctx .  vars H : Hnd .

  eq holds(V, L) holds(V, L) = holds(V, L) .
  eq envelope(V, L, H, C) envelope(V, L, H, C) = envelope(V, L, H, C) .
  eq unwrapped(V, L) unwrapped(V, L) = unwrapped(V, L) .
  eq refused(V) refused(V) = refused(V) .
  eq laundered laundered = laundered .
  eq confused confused = confused .

  --- Wrapping records the label in the envelope. This is the ruling: the
  --- label rides with the ciphertext, so the boundary carries rather than
  --- launders. The custodian must hold the key -- whip cannot wrap alone.
  rl [wrap] : holds(V, L) wrapReq(V, H, C) sealed(H)
    => holds(V, L) wrapReq(V, H, C) sealed(H) envelope(V, L, H, C) .

  --- Unwrapping restores the recorded label, and only in the bound context.
  crl [unwrap] : envelope(V, L, H, C) unwrapReq(V, H, D) sealed(H)
    => envelope(V, L, H, C) unwrapReq(V, H, D) sealed(H) unwrapped(V, L)
    if C == D .

  --- A context mismatch REFUSES. It does not fall back to unwrapping anyway.
  crl [unwrap-context-mismatch] : envelope(V, L, H, C) unwrapReq(V, H, D)
    => envelope(V, L, H, C) unwrapReq(V, H, D) refused(V)
    if C =/= D .

  --- The restored value re-enters whip's value space AT ITS LABEL.
  rl [observe] : unwrapped(V, L) => unwrapped(V, L) holds(V, L) .

  --- VIOLATION: a value that began secret is observed public after the
  --- roundtrip. That is the laundering the ruling exists to prevent.
  rl [detect-launder] : origin(V, secret) unwrapped(V, public)
    => origin(V, secret) unwrapped(V, public) laundered .
endm

--- NEGATIVE FIXTURE 1. The rejected design in which the envelope carries only
--- ciphertext and no label, so unwrapped data re-enters unlabelled. This is
--- the laundering path, and it exists so the main module's No-solution has
--- demonstrated content.
mod WHIPPLESCRIPT-CREDENTIAL-WRAP-CARRIAGE-UNLABELLED is
  protecting BOOL .
  sorts Val Label Ctx Hnd Cfg .

  ops v1 v2 : -> Val [ctor] .
  ops secret public : -> Label [ctor] .
  ops ctxA ctxB : -> Ctx [ctor] .
  ops h1 h2 : -> Hnd [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op holds : Val Label -> Cfg [ctor] .
  op origin : Val Label -> Cfg [ctor] .
  op wrapReq : Val Hnd Ctx -> Cfg [ctor] .
  op blob : Val Hnd Ctx -> Cfg [ctor] .
  op unwrapReq : Val Hnd Ctx -> Cfg [ctor] .
  op unwrapped : Val Label -> Cfg [ctor] .
  op sealed : Hnd -> Cfg [ctor] .
  op laundered : -> Cfg [ctor] .

  vars V : Val .  vars L : Label .  vars C D : Ctx .  vars H : Hnd .

  eq holds(V, L) holds(V, L) = holds(V, L) .
  eq blob(V, H, C) blob(V, H, C) = blob(V, H, C) .
  eq unwrapped(V, L) unwrapped(V, L) = unwrapped(V, L) .
  eq laundered laundered = laundered .

  --- THE REJECTED WRAP: the label is dropped at the boundary.
  rl [wrap-unlabelled] : holds(V, L) wrapReq(V, H, C) sealed(H)
    => holds(V, L) wrapReq(V, H, C) sealed(H) blob(V, H, C) .

  --- ...so what comes back is public by default.
  rl [unwrap-unlabelled] : blob(V, H, C) unwrapReq(V, H, D) sealed(H)
    => blob(V, H, C) unwrapReq(V, H, D) sealed(H) unwrapped(V, public) .

  rl [detect-launder] : origin(V, secret) unwrapped(V, public)
    => origin(V, secret) unwrapped(V, public) laundered .
endm

--- NEGATIVE FIXTURE 2. The rejected design in which the envelope is not bound
--- to its context, so a ciphertext produced for one context unwraps happily in
--- another. Both values may be perfectly labelled, which is why label carriage
--- alone does not catch this and AEAD associated data is a separate
--- requirement.
mod WHIPPLESCRIPT-CREDENTIAL-WRAP-CARRIAGE-UNBOUND is
  protecting BOOL .
  sorts Val Label Ctx Hnd Cfg .

  ops v1 v2 : -> Val [ctor] .
  ops secret public : -> Label [ctor] .
  ops ctxA ctxB : -> Ctx [ctor] .
  ops h1 h2 : -> Hnd [ctor] .

  op none : -> Cfg [ctor] .
  op __ : Cfg Cfg -> Cfg [ctor assoc comm id: none] .

  op holds : Val Label -> Cfg [ctor] .
  op wrapReq : Val Hnd Ctx -> Cfg [ctor] .
  op envelope : Val Label Hnd Ctx -> Cfg [ctor] .
  op unwrapReq : Val Hnd Ctx -> Cfg [ctor] .
  op unwrapped : Val Label -> Cfg [ctor] .
  op sealed : Hnd -> Cfg [ctor] .
  op confused : -> Cfg [ctor] .

  vars V : Val .  vars L : Label .  vars C D : Ctx .  vars H : Hnd .

  eq holds(V, L) holds(V, L) = holds(V, L) .
  eq envelope(V, L, H, C) envelope(V, L, H, C) = envelope(V, L, H, C) .
  eq unwrapped(V, L) unwrapped(V, L) = unwrapped(V, L) .
  eq confused confused = confused .

  rl [wrap] : holds(V, L) wrapReq(V, H, C) sealed(H)
    => holds(V, L) wrapReq(V, H, C) sealed(H) envelope(V, L, H, C) .

  --- THE REJECTED UNWRAP: context is not checked.
  crl [unwrap-any-context] : envelope(V, L, H, C) unwrapReq(V, H, D) sealed(H)
    => envelope(V, L, H, C) unwrapReq(V, H, D) sealed(H) unwrapped(V, L) confused
    if C =/= D .
endm
