workflow OpenClawLite
source_tags
@service workflow OpenClawLite
uses
  package std.agent.claude
  package std.agent.codex
  package std.memory
  package std.tracker
schemas
  class Heartbeat
    job string
    status literal<"observed">
  class Plan
    title string
    summary string
    status literal<"ready">
trackers
  tracker backlog provider=builtin
agents
  agent planner harness=<fallback> provider=codex profile=repo-reader capacity=1 skills=[] capabilities=[] tools=[] class=delegated
assertions
  assert count(Heartbeat where status == "observed") == 1
    reads
      fact:Heartbeat where status == "observed"
  assert count(Plan where status == "ready") == 1
    reads
      fact:Plan where status == "ready"
  assert count(effect kind tracker.file where status == completed) == 1
    reads
      effect:kind tracker.file where status == completed
rules
  rule observe_heartbeat
    when started
    reads
      pattern:started
    writes
      schema:Heartbeat
    body_hash 8211397354763d75e60ac3272de48408
  rule plan_recurring_work
    when Heartbeat as beat where beat.status == "observed"
    when planner is available
    reads
      pattern:planner is available
      schema:Heartbeat
    writes
      schema:Plan
    effects
      context kind=capability.call binding=context key=7f1b4ae835c680dd269eda813cae3511
      planTurn kind=agent.tell binding=planTurn key=160376d1d7d8cb740b2612cdc88f11a4 arm=context:succeeds
      effect3 kind=tracker.file binding=- key=33c89ee6807957a9839dd51516715552 arm=planTurn:succeeds
      effect4 kind=capability.call binding=- key=1c03939441cac35a45777eabf4e20762 arm=planTurn:succeeds
    dependencies
      context --succeeds--> planTurn
      planTurn --succeeds--> effect3
      planTurn --succeeds--> effect4
    body_hash 23daff61e320934af1c3e729a3b4629a
rule_dependencies
  observe_heartbeat --schema:Heartbeat--> plan_recurring_work
