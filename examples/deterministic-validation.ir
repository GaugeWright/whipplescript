workflow DeterministicValidation
workflow_contracts
  output result ref<ValidationReport>
  failure error ref<ValidationFailed>
uses
  package std.script
schemas
  class Artifact
    path string
    expectedScript string
  class ScriptCheck
    isExpectedScript bool
    detail string
  class ValidationReport
    path string
    detail string
  class ValidationFailed
    reason string
rules
  rule table_artifacts
    when started
    reads
      pattern:started
    writes
      schema:Artifact
    record_sources
      schema:Artifact construct=table_row span=1050..1119
    body_hash b6c7fc10fa2f25f426e1d35f1f3b963a
  rule validate_artifact_script
    when Artifact as artifact
    reads
      schema:Artifact
    consumes
      schema:Artifact
    effects
      check kind=exec.command binding=check key=36febac44ac95de9d1581cdad0fa9b77
    body_hash 0c2290b1120ed2e17a1a5029a77baeb1
rule_dependencies
  table_artifacts --schema:Artifact--> validate_artifact_script
