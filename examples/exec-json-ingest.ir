workflow ExecJsonIngest
workflow_contracts
  output result ref<TestSummary>
  failure error ref<TestFailure>
uses
  package std.script
schemas
  class TestSummary
    passed bool
    failed int
  class FailedTest
    name string
    reason string
  class TestFailure
    reason string
rules
  rule run_test_report
    when started
    reads
      pattern:started
    effects
      report kind=exec.command binding=report key=fb4ef6c32790211e4d5f15c109b0405b
    body_hash 0790aecc3e2d30280fce9015ba0d06e9
  rule ingest_failed_tests
    when started
    reads
      pattern:started
    writes
      schema:FailedTest
    effects
      effect1 kind=exec.command binding=- key=fd4fb074cfc76ecbe0b702e8467ad23b
    body_hash 926044308c8ce4b46482e9b0b62dbbdf
