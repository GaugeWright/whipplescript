workflow QueueWorkerWithReview
source_tags
@service workflow QueueWorkerWithReview
source_descriptions
"Claim ready work items, implement them, review each turn, and escalate failed reviews to a human" workflow QueueWorkerWithReview
uses
  package std.coercion
  package std.tracker
  package std.agent
schemas
  enum ReviewStatus { Accept, Revise, Blocked }
  class WorkReview
    status ref<ReviewStatus>
    reason string
    followups array<string>
    confidence float
  class ReviewedWork
    itemId string
    review ref<WorkReview>
trackers
  tracker backlog provider=builtin
agents
  agent worker harness=<fallback> provider=owned profile=repo-writer capacity=1 skills=[] capabilities=[] tools=[]
coerces
  coerce reviewWork(itemTitle string, agentSummary string) -> ref<WorkReview>
rules
  rule work_ready_item
    when backlog has ready issue as issue
    when worker is available
    reads
      pattern:backlog has ready issue as issue
      pattern:worker is available
    writes
      schema:ReviewedWork
    effects
      active_claim kind=tracker.claim binding=active_claim key=f9b8e615dc6b0001a3b1a9d844181da3
      turn kind=agent.tell binding=turn key=646546e2b1b8aa39e978f44def9967a2 arm=active_claim:succeeds
      review kind=schema.coerce binding=review key=c11847c6fd4d8d7e6daf04ebfb49ff68 arm=turn:succeeds
      effect4 kind=tracker.finish binding=- key=28a4c3372ca9812f259710ce95997e91 arm=review:succeeds
      effect5 kind=tracker.release binding=- key=23385968a426d985a6f3faf2c50da4bc arm=review:fails
    dependencies
      active_claim --succeeds--> turn
      turn --succeeds--> review
      review --succeeds--> effect4
      review --fails--> effect5
    body_hash 13505c8a19a1cbf39e44638654974327
rule_dependencies
  work_ready_item --tracker:backlog--> work_ready_item
