workflow AutoResearchLite
workflow_contracts
  output result ref<ResearchResult>
  failure error ref<ResearchStopped>
uses
  package std.coord
  package std.script
schemas
  class ResearchProject
    id string
  class Hypothesis
    id string
    project ref<ResearchProject>
    idea string
    status literal<"queued">
  class ExperimentMetric
    score float
    notes string
  class ResearchResult
    hypothesisId string
    score float
    decision literal<"keep">
  class ResearchStopped
    reason string
rules
  rule table_projects
    when started
    reads
      pattern:started
    writes
      schema:ResearchProject
    record_sources
      schema:ResearchProject construct=table_row span=721..753
    body_hash 1ca63914a8e9d3d4221c2122c45bca37
  rule table_hypotheses
    when started
    reads
      pattern:started
    writes
      schema:Hypothesis
    record_sources
      schema:Hypothesis construct=table_row span=792..924
    body_hash 9295d0f379a2ee2edc5819a1dcea4233
  rule run_budgeted_experiment
    when Hypothesis as hypothesis where hypothesis.status == "queued"
    reads
      schema:Hypothesis
    consumes
      schema:Hypothesis
    effects
      budget kind=counter.consume binding=budget key=40a647a96303801f2652699a5f494e3d
      metric kind=exec.command binding=metric key=5bb1c65c9c5f791e31c058d5f6c6a97e
    dependencies
      budget --completes--> metric
    body_hash c48222fe2596671a93061d32141e8ef4
rule_dependencies
  table_hypotheses --schema:Hypothesis--> run_budgeted_experiment
