use std.coercion
use std.tracker

@service
workflow CoerceBranch

# Work that needs a human is filed into the tracker; an operator picks it up
# with `whip issue`. (Human review is the tracker, not a language construct.)
tracker review {
  provider builtin
}


# `coerce` turns unstructured work into typed schema-coercion output with failure handling.
enum Priority {
  Low
  Normal
  Urgent
}

class MessageClassification {
  priority Priority
  summary string
  confidence float
}

class ClassifiedMessage {
  request WorkItem
  classification MessageClassification
}

coerce classifyMessage(title string, body string) -> MessageClassification {
  prompt """markdown
  Classify this work request.

  Title:
  {{ title }}

  Body:
  {{ body }}

  Return a priority, summary, and confidence.

  {{ ctx.output_format }}
  """
}

rule classify_request
  when WorkItem as request
=> {
  coerce classifyMessage(request.title, request.body) as classification

  after classification succeeds {
    record ClassifiedMessage {
      request request
      classification classification
    }
  }

  after classification fails {
    file issue into review {
      title "Classify manually: {{ request.title }}"
      body "Automated classification failed; choose a priority and summarize the work."
    }
  }
}

rule route_classified
  when ClassifiedMessage as message
=> {
  file issue into review {
    title "Route classified request: {{ message.request.title }}"
    body "{{ message.classification.summary }}"
  }
}
