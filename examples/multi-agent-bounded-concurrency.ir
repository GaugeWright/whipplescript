workflow MultiAgentBoundedConcurrency
source_tags
@service workflow MultiAgentBoundedConcurrency
source_descriptions
"Two agents with bounded capacity handing work to each other through a queue" workflow MultiAgentBoundedConcurrency
uses
  package std.tracker
  package std.agent.claude
  package std.agent.codex
trackers
  tracker backlog provider=builtin
agents
  agent implementer harness=<fallback> provider=codex profile=repo-writer capacity=2 skills=[] capabilities=[] tools=[] class=delegated
  agent reviewer harness=<fallback> provider=claude profile=repo-reader capacity=1 skills=[] capabilities=[] tools=[] class=delegated
rules
  rule implement_ready_work
    when backlog has ready issue as issue
    when implementer is available
    reads
      pattern:backlog has ready issue as issue
      pattern:implementer is available
    effects
      active_claim kind=tracker.claim binding=active_claim key=cb7e25b5f2da26b1bc15c393c7d59caa
      turn kind=agent.tell binding=turn key=1f5a5a19ebbebe916906b261da56ffe7 arm=active_claim:succeeds
      effect3 kind=tracker.finish binding=- key=f5f36187e872a4bca8c5e26289b35ad1 arm=turn:succeeds
    dependencies
      active_claim --succeeds--> turn
      turn --succeeds--> effect3
    body_hash e0b3cad0b8480cc134e269c1076ed780
  rule review_completed_turn
    when implementer completed turn as turn
    when reviewer is available
    reads
      pattern:implementer completed turn as turn
      pattern:reviewer is available
    effects
      effect1 kind=agent.tell binding=- key=18c5693fb6fb791e064a38034c5245c4
    body_hash 9a8cb3cd3f112aaf951130a43f0338bb
