workflow Ralph
source_tags
@service workflow Ralph
uses
  package std.agent
agents
  agent ralph harness=<fallback> provider=fixture profile=repo-writer capacity=1 skills=[] capabilities=[] tools=[]
rules
  rule begin
    when started
    when ralph is available
    reads
      pattern:ralph is available
      pattern:started
    effects
      effect1 kind=agent.tell binding=- key=f66f41a3a63d6b9d16f2fdfd1429e12e
    body_hash 668d232e0954356a2b32d2b0b6dac1ec
  rule again
    when ralph completed turn
    when ralph is available
    reads
      pattern:ralph completed turn
      pattern:ralph is available
    effects
      effect1 kind=agent.tell binding=- key=7026ee67ac4b241c29d45c20e8a42378
    body_hash 668d232e0954356a2b32d2b0b6dac1ec
