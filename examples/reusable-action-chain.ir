workflow ReusableActionChain
workflow_contracts
  output result ref<ReviewBatch>
  failure error ref<ReviewFailure>
uses
  package std.agent
schemas
  class ChangeRequest
    id string
    title string
    status literal<"queued">
  class ReviewedChange
    id string
    summary string
    status literal<"reviewed">
  class ReviewBatch
    reviewed int
  class ReviewFailure
    reason string
agents
  agent reviewer harness=<fallback> provider=fixture profile=repo-reader capacity=1 skills=[] capabilities=[] tools=[]
assertions
  assert count(ChangeRequest where status == "queued") == 0
    reads
      fact:ChangeRequest where status == "queued"
  assert count(ReviewedChange where status == "reviewed") == 1
    reads
      fact:ReviewedChange where status == "reviewed"
rules
  rule table_changes
    when started
    reads
      pattern:started
    writes
      schema:ChangeRequest
    record_sources
      schema:ChangeRequest construct=table_row span=677..750
    body_hash 1e2d8eb96f5c5e1d8eeee67fe2c9f6a9
  rule review
    when ChangeRequest as item
    when reviewer is available
    reads
      pattern:reviewer is available
      schema:ChangeRequest
    writes
      schema:ReviewFailure
      schema:ReviewedChange
    consumes
      schema:ChangeRequest
    effects
      turn__act0 kind=agent.tell binding=turn__act0 key=9508d6f0eae6a7c101338dda98a70e4e
    body_hash 8e6e780e4b21217b8c4a44b3309b8fb1
  rule fail_on_review_failure
    when ReviewFailure as failure
    reads
      schema:ReviewFailure
    body_hash 43039c5d012c0c51c30a78dd1bc45f42
  rule finish_batch
    when ReviewedChange as reviewed where reviewed.status == "reviewed"
    reads
      schema:ReviewedChange
    body_hash 9f67c4dc6503354813b32a186c7ca679
rule_dependencies
  review --schema:ReviewFailure--> fail_on_review_failure
  review --schema:ReviewedChange--> finish_batch
  table_changes --schema:ChangeRequest--> review
