use std.agent

workflow ReusableActionChain

output result ReviewBatch
failure error ReviewFailure

# `action` removes a repeated *intra-rule effect chain*. Unlike `pattern`, which
# generates whole declarations, a typed action contributes an inspectable scope
# to the durable graph and returns a value to its caller (DR-0100).
class ChangeRequest {
  id string
  title string
  status "queued"
}

class ReviewedChange {
  id string
  summary string
  status "reviewed"
}

class ReviewBatch {
  reviewed int
}

class ReviewFailure {
  reason string
}

agent reviewer {
  provider fixture
  profile "repo-reader"
  capacity 1
}

table changes as ChangeRequest [
  {
    id "CR-1"
    title "Simplify retry policy"
    status "queued"
  }
]

# A typed, hygienic action over a rule-body effect graph. Its null result makes
# completion explicit even though this caller does not bind the value.
action review_change(who AgentRef<reviewer>, item ChangeRequest) -> null {
  tell who as turn """markdown
  Review {{ item.title }}.
  """

  after turn succeeds {
    done item -> record ReviewedChange {
      id item.id
      summary "reviewed"
      status "reviewed"
    }
    return null
  }

  after turn fails {
    record ReviewFailure {
      reason "review failed"
    }
    return null
  }
}

assert count(ChangeRequest where status == "queued") == 0
assert count(ReviewedChange where status == "reviewed") == 1

rule review
  when ChangeRequest as item
  when reviewer is available
=> {
  review_change(reviewer, item)
}

rule fail_on_review_failure
  when ReviewFailure as failure
=> {
  fail error {
    reason failure.reason
  }
}

rule finish_batch
  when ReviewedChange as reviewed where reviewed.status == "reviewed"
=> {
  complete result {
    reviewed 1
  }
}
