workflow CoerceBranch
source_tags
@service workflow CoerceBranch
uses
  package std.coercion
  package std.tracker
schemas
  enum Priority { Low, Normal, Urgent }
  class MessageClassification
    priority ref<Priority>
    summary string
    confidence float
  class ClassifiedMessage
    request ref<WorkItem>
    classification ref<MessageClassification>
trackers
  tracker review provider=builtin
coerces
  coerce classifyMessage(title string, body string) -> ref<MessageClassification>
rules
  rule classify_request
    when review has ready issue as request
    reads
      pattern:review has ready issue as request
    writes
      schema:ClassifiedMessage
    effects
      active_claim kind=tracker.claim binding=active_claim key=3d04fedec851786f38bf4e8fe5acc9e2
      classification kind=schema.coerce binding=classification key=44afbf47e063e5764d019b64e8b18e22
      effect3 kind=tracker.file binding=- key=eb527750949abe45eecc99a09085da09
    dependencies
      active_claim --succeeds--> classification
      classification --fails--> effect3
    body_hash b6d9e2b83b3d31373d82a37fb990d818
  rule route_classified
    when ClassifiedMessage as message
    reads
      schema:ClassifiedMessage
    effects
      effect1 kind=tracker.file binding=- key=156eb35678c182e9d002e61ccea00108
    body_hash 730386b76fd397c24a45d6c2353028be
rule_dependencies
  classify_request --schema:ClassifiedMessage--> route_classified
