workflow ReusableReviewPattern
pattern_applications
  AgentReview as changeReview<ref<ChangeRequest>, ref<ReviewedChange>>
    defined-at 671..1125
    applied-at 1127..1195
    generated rule:changeReview_review
workflow_contracts
  output result ref<ReviewBatch>
  failure error ref<ReviewFailure>
uses
  package std.agent
schemas
  class ChangeRequest
    id string
    title string
    status literal<"queued">
  class ReviewedChange
    id string
    summary string
    status literal<"reviewed">
  class ReviewBatch
    reviewed int
  class ReviewFailure
    reason string
agents
  agent reviewer harness=<fallback> provider=owned profile=repo-reader capacity=1 skills=[] capabilities=[] tools=[]
assertions
  assert count(ChangeRequest where status == "queued") == 0
    reads
      fact:ChangeRequest where status == "queued"
  assert count(ReviewedChange where status == "reviewed") == 1
    reads
      fact:ReviewedChange where status == "reviewed"
rules
  rule table_changes
    when started
    reads
      pattern:started
    writes
      schema:ChangeRequest
    record_sources
      schema:ChangeRequest construct=table_row span=518..591
    body_hash 1e2d8eb96f5c5e1d8eeee67fe2c9f6a9
  rule changeReview_review
    when ChangeRequest as item
    when reviewer is available
    reads
      pattern:reviewer is available
      schema:ChangeRequest
    writes
      schema:ReviewFailure
      schema:ReviewedChange
    consumes
      schema:ChangeRequest
    effects
      turn kind=agent.tell binding=turn key=0e377cfe28b825e30313398886da4dce
    body_hash c5861f782a35fc3e965da7890198d622
  rule fail_on_review_failure
    when ReviewFailure as failure
    reads
      schema:ReviewFailure
    body_hash 43039c5d012c0c51c30a78dd1bc45f42
  rule finish_batch
    when ReviewedChange as reviewed where reviewed.status == "reviewed"
    reads
      schema:ReviewedChange
    body_hash 9f67c4dc6503354813b32a186c7ca679
rule_dependencies
  changeReview_review --schema:ReviewFailure--> fail_on_review_failure
  changeReview_review --schema:ReviewedChange--> finish_batch
  table_changes --schema:ChangeRequest--> changeReview_review
