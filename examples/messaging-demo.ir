workflow MessagingDemo
source_tags
@service workflow MessagingDemo
source_descriptions
"Inbound + outbound messaging: react to a channel message and reply on the same channel" workflow MessagingDemo
workflow_contracts
  output result ref<Handled>
uses
  package std.messaging
schemas
  class Handled
    reply string
channels
  channel ops_room provider=fixture destination="#ops"
rules
  rule acknowledge_message
    when message from ops_room as msg
    reads
      pattern:message from ops_room as msg
    effects
      reply kind=capability.call binding=reply construct=send->messaging.send key=ebbf62ddd92a9bb6882f32ac88a1498b
    body_hash b1031d50a50b6011bea84b2a5b7e7775
rule_dependencies
  acknowledge_message --channel:ops_room--> acknowledge_message
