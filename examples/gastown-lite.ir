workflow GastownLite
source_tags
@service workflow GastownLite
uses
  package std.coercion
  package std.coord
  package std.tracker
  package std.agent
schemas
  class Workspace
    name string
  class Ticket
    id string
    title string
    area union<literal<"frontend"> | literal<"backend">>
    worker agentref<frontend | backend>
    workspace ref<Workspace>
    status literal<"ready">
  class ReviewDecision
    ticketId string
    area string
    verdict union<literal<"merge"> | literal<"revise"> | literal<"blocked">>
  class MergeRecord
    ticketId string
    verdict literal<"merge">
  class WorkspaceReady
    workspace ref<Workspace>
trackers
  tracker backlog provider=builtin
agents
  agent frontend harness=<fallback> provider=owned profile=repo-writer capacity=1 skills=[] capabilities=[] tools=[]
  agent backend harness=<fallback> provider=owned profile=repo-writer capacity=1 skills=[] capabilities=[] tools=[]
coerces
  coerce reviewPatch(ticketId string, summary string) -> ref<ReviewDecision>
rules
  rule table_workspaces
    when started
    reads
      pattern:started
    writes
      schema:WorkspaceReady
    record_sources
      schema:WorkspaceReady construct=table_row span=946..985
    body_hash bfd2f6ca2d247b96c0d0d1e60c19be7b
  rule file_ticket
    when started
    reads
      pattern:started
    effects
      effect1 kind=tracker.file binding=- key=90768f06f63ae017024a1498eeb15901
    body_hash b283b4d3475099aa263f93579a6bb2f5
  rule implement_ready_ticket
    when backlog has ready issue as issue
    when WorkspaceReady as ready
    when frontend is available
    reads
      pattern:backlog has ready issue as issue
      pattern:frontend is available
      schema:WorkspaceReady
    writes
      schema:MergeRecord
    effects
      claimed kind=tracker.claim binding=claimed key=ea89cbaf03db98ca1752806578c92108
      slot kind=lease.acquire binding=slot key=b49f59f40d86864795918debcb703c8f arm=claimed:succeeds
      turn kind=agent.tell binding=turn key=703adb3084d862acbb29fb95914ee41b arm=slot:held
      effect4 kind=tracker.release binding=- key=774301c99cf55083c80f3daf2b382776 arm=slot:contended
      review kind=schema.coerce binding=review key=2b7bcdf94cc0b6f1a9949e8c06121470 arm=turn:succeeds
      log_entry kind=ledger.append binding=log_entry key=cff8c48b12170d938db4dca84b4c53ec arm=review:succeeds
      effect7 kind=tracker.finish binding=- key=73f2857ebc87383ff27d61a0e0b5a419 arm=log_entry:succeeds
      effect8 kind=tracker.release binding=- key=341e2484f8794650a07e0e655bd1d536 arm=log_entry:succeeds
      effect9 kind=tracker.release binding=- key=656c54c42411e2993e0713acd35295cb arm=log_entry:succeeds
    dependencies
      claimed --succeeds--> slot
      slot --completes--> turn
      slot --completes--> effect4
      turn --succeeds--> review
      review --succeeds--> log_entry
      log_entry --succeeds--> effect7
      log_entry --succeeds--> effect8
      log_entry --succeeds--> effect9
    case_branches
      case decision.verdict type=union<literal<"merge"> | literal<"revise"> | literal<"blocked">> pattern=literal:"merge" guard=- body_hash=46c8bd9b93a57f4ec41bfcb56bd31ff3 span=2224..2231
      case decision.verdict type=union<literal<"merge"> | literal<"revise"> | literal<"blocked">> pattern=literal:"revise" guard=- body_hash=7131ffc41c4190ff0d03d76828c6707e span=2408..2416
      case decision.verdict type=union<literal<"merge"> | literal<"revise"> | literal<"blocked">> pattern=literal:"blocked" guard=- body_hash=7131ffc41c4190ff0d03d76828c6707e span=2458..2467
    body_hash 02c957e883c9a832daf0dfbfbbab9259
rule_dependencies
  file_ticket --tracker:backlog--> implement_ready_ticket
  implement_ready_ticket --tracker:backlog--> implement_ready_ticket
  table_workspaces --schema:WorkspaceReady--> implement_ready_ticket
